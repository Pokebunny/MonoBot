                // A morph pick&apos;s precursor can&apos;t stand in for it: its weapon is removed.
                bool MB_OnUnitCreated (bool testConds, bool runActions) {
                    unit u;
                    string pick;
                    u = EventUnitCreatedUnit();
                    if (gv_phase != MB_PHASE_BATTLE || UnitGetOwner(u) &lt; 1 || UnitGetOwner(u) &gt; 8) {
                        return true;
                    }
                    if (gv_pick[UnitGetOwner(u)] == 0) {
                        return true;
                    }
                    pick = gv_unitName[gv_pick[UnitGetOwner(u)]];
                    if (pick == &quot;Baneling&quot; &amp;&amp; UnitGetType(u) == &quot;Zergling&quot;) {
                        UnitWeaponRemove(u, &quot;Claws&quot;);
                    }
                    else if (pick == &quot;Ravager&quot; &amp;&amp; UnitGetType(u) == &quot;Roach&quot;) {
                        UnitWeaponRemove(u, &quot;AcidSaliva&quot;);
                        UnitWeaponRemove(u, &quot;RoachMelee&quot;);
                    }
                    else if (pick == &quot;Lurker&quot; &amp;&amp; UnitGetType(u) == &quot;Hydralisk&quot;) {
                        UnitWeaponRemove(u, &quot;HydraliskMelee&quot;);
                        UnitWeaponRemove(u, &quot;NeedleSpines&quot;);
                    }
                    else if (pick == &quot;BroodLord&quot; &amp;&amp; UnitGetType(u) == &quot;Corruptor&quot;) {
                        UnitWeaponRemove(u, &quot;ParasiteSpore&quot;);
                    }
                    else if (pick == &quot;Archon&quot; &amp;&amp; UnitGetType(u) == &quot;DarkTemplar&quot;) {
                        UnitWeaponRemove(u, &quot;WarpBlades&quot;);
                    }
                    return true;
                }

                //--------------------------------------------------------------------------------------------------
                // Pick panel, one per player, 1000 wide and as tall as the phase needs (MB_Layout), top to bottom:
                //   title
                //   up to 4 text buttons, centred (above the cards, or below them in the drafts)
                //   unit cards, 4 per row, a short last row centred: icon (52) with its name on a 200-wide button
                //     beneath, wide enough for &quot;Hellion/Hellbat&quot;
                //   0-2 team strips: a unit icon and a player name per slot
                //   one info line
                // Clicking a card&apos;s icon or its name picks it. Taken units go grey; the current choice&apos;s name is
                // green.
                //--------------------------------------------------------------------------------------------------
                const int MB_CARD_COLUMNS = 4;
                const int MB_CARD_WIDTH = 200;
                const int MB_CARD_GAP = 40;
                const int MB_CARD_ICON = 52;
                const int MB_CARD_NAME_HEIGHT = 36;  // shorter and the game reports names as too tall for a line
                const int MB_CARD_PITCH = 96;   // icon, 4, name button, 4
                const int MB_PANEL_WIDTH = 1000;

