                bool MB_AllVoted () {
                    int p;
                    for (p = 1; p &lt;= 8; p += 1) {
                        if (MB_TeamOf(p) != 0 &amp;&amp; MB_IsPlaying(p) &amp;&amp; gv_vote[p] == 0) {
                            return false;
                        }
                    }
                    return true;
                }

                // Everyone still in has locked in their pick: the pick phase can end early.
                bool MB_AllLocked () {
                    int p;
                    for (p = 1; p &lt;= 8; p += 1) {
                        if (MB_TeamOf(p) != 0 &amp;&amp; MB_IsPlaying(p) &amp;&amp; !gv_locked[p]) {
                            return false;
                        }
                    }
                    return true;
                }

                // Most votes wins; ties (including nobody voting) are broken at random.
                int MB_VoteResult () {
                    int best;
                    int m;
                    int[5] tied;
                    int n;
                    best = 0;
                    for (m = 1; m &lt;= 4; m += 1) {
                        if (MB_VoteCount(m) &gt; best) {
                            best = MB_VoteCount(m);
                        }
                    }
                    n = 0;
                    for (m = 1; m &lt;= 4; m += 1) {
                        if (MB_VoteCount(m) == best) {
                            n += 1;
                            tied[n] = m;
                        }
                    }
                    return tied[RandomInt(1, n)];
                }

                // The host&apos;s &quot;Pick mode&quot; lobby setting (Attributes, id 1): 0 = vote in game.
                int MB_LobbyMode () {
                    string value;
                    value = GameAttributeGameValue(&quot;1&quot;);
                    if (value == &quot;0002&quot;) {
                        return MB_MODE_BLIND;
                    }
                    if (value == &quot;0003&quot;) {
                        return MB_MODE_SINGLE;
                    }
                    if (value == &quot;0004&quot;) {
                        return MB_MODE_PICK_THREE;
                    }
                    if (value == &quot;0005&quot;) {
