                    }
                    else if (gv_phase == MB_PHASE_ASSIGN) {
                        for (t = 1; t &lt;= 2; t += 1) {
                            s = s + MB_Text(&quot;Team &quot; + IntToString(t) + &quot;&lt;n/&gt;&quot;) + MB_AssignLines(t);
                        }
                    }
                    else {
