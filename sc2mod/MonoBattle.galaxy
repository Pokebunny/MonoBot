//==================================================================================================
// MonoBattle - an extension mod: monobattles on any 4v4 melee map.
//
// Each player builds one army unit. The mod freezes the start, runs a pick phase in one of four
// modes, spawns every player's base in their pick's race, and ends the game itself. Facts MonoBot
// needs are granted as no-effect upgrades named MB_* (defined in UpgradeData.xml, read by
// main/services/replay_parser.py); see sc2mod/README.md.
//
// Entry point: MB_Init (set it as the Custom Script's initialization function).
//==================================================================================================
include "TriggerLibs/NativeLib"

//--------------------------------------------------------------------------------------------------
// Settings
//--------------------------------------------------------------------------------------------------
// Bump when the rules change; MonoBot reads it from MB_Version.
const int MB_VERSION = 1;

const int MB_UNITS = 42;
const int MB_ZERG_FIRST = 1;      // roster index ranges, by race
const int MB_ZERG_LAST = 13;
const int MB_PROTOSS_FIRST = 14;
const int MB_PROTOSS_LAST = 28;
const int MB_TERRAN_FIRST = 29;
const int MB_TERRAN_LAST = 42;

const int MB_POOL_SIZE = 20;      // Single Draft and Captains Draft pool

// Pick-phase timers, in real seconds.
const int MB_VOTE_SECONDS = 14;
const int MB_BLIND_SECONDS = 30;
const int MB_PICK_THREE_SECONDS = 30;
const int MB_DRAFT_TURN_SECONDS = 30;
const int MB_OPT_IN_SECONDS = 10;
const int MB_ASSIGN_SECONDS = 30;

// No resource trading until 10:00 on the in-game clock (a house rule). The clock shows real
// seconds at Faster speed, 1.4 game seconds each, and starts when the battle does.
const fixed MB_TRADE_LOCK_GAME_SECONDS = 840.0;

// Lifted-off Terran buildings start burning this long into the battle if they're all a player has.
const fixed MB_FLOATER_GRACE_GAME_SECONDS = 168.0;  // 2:00 on the clock
const int MB_FLOATER_WARNING_SECONDS = 10;

const int MB_MODE_BLIND = 1;
const int MB_MODE_SINGLE = 2;
const int MB_MODE_PICK_THREE = 3;
const int MB_MODE_CAPTAINS = 4;

const int MB_PHASE_NONE = 0;
const int MB_PHASE_VOTE = 1;
const int MB_PHASE_BLIND = 2;
const int MB_PHASE_PICK_THREE = 3;
const int MB_PHASE_SINGLE = 4;
const int MB_PHASE_OPT_IN = 5;
const int MB_PHASE_CAPTAIN_DRAFT = 6;
const int MB_PHASE_ASSIGN = 7;
const int MB_PHASE_BATTLE = 8;

const int MB_BUTTONS = 20;

//--------------------------------------------------------------------------------------------------
// State
//--------------------------------------------------------------------------------------------------
string[43] gv_unitName;   // canonical name: marker suffix and MonoBot's name for the unit
string[43] gv_unitLabel;  // shown to players
string[43] gv_unitRace;   // "Zerg" | "Prot" | "Terr"
string[43] gv_unitIcon;   // portrait texture

int gv_mode;
int gv_phase;

int[9] gv_pick;           // roster index, 0 = none yet
bool[9] gv_locked;
int[9] gv_rolls;          // Blind Random rolls taken
int[9] gv_raceChoice;     // Blind Random: 1 Random, 2 Terran, 3 Zerg, 4 Protoss
int[9][4] gv_offer;       // Pick Three offers, [player][1..3]
int[9] gv_vote;

int[3][5] gv_teamPlayers; // [team][1..4]
int[3] gv_teamSize;

bool[43] gv_used;         // Pick Three: units already offered in the team being dealt
int[21] gv_pool;          // draft pool, roster indexes
bool[21] gv_poolTaken;
int[9] gv_order;          // draft turn order
int gv_orderCount;
int gv_turnPlayer;
bool gv_turnDone;

bool[9] gv_optIn;
int[3] gv_captain;
int[3][5] gv_teamUnits;   // Captains Draft: [team][1..n] roster indexes drafted
int[3] gv_teamUnitCount;
int[3][5] gv_assignee;    // [team][unit slot] -> player
int[3] gv_selectedSlot;   // captain's unit slot waiting for a player

int[9] gv_floatSeconds;   // consecutive seconds a Terran has had only lifted-off buildings

// Per-player pick panel
int[9] gv_dialog;
int[9] gv_title;
int[9] gv_info;
int[9][21] gv_button;

// Picks panel: everyone's unit in the top-left corner during the battle, as on the old map
int gv_picksDialog;
int gv_picksToggle;
int[3][5] gv_picksPortrait;
int[3][5] gv_picksName;
bool[17] gv_picksHidden;  // per viewer, observers included

//--------------------------------------------------------------------------------------------------
// Prototypes
//--------------------------------------------------------------------------------------------------
void MB_StartBattle ();
void MB_RefreshInfo ();

//--------------------------------------------------------------------------------------------------
// Small helpers
//--------------------------------------------------------------------------------------------------
text MB_Text (string s) {
    return StringToText(s);
}

bool MB_IsPlaying (int p) {
    return PlayerStatus(p) == c_playerStatusActive;
}

int MB_TeamOf (int p) {
    if (PlayerGroupHasPlayer(GameAttributePlayersForTeam(1), p)) {
        return 1;
    }
    if (PlayerGroupHasPlayer(GameAttributePlayersForTeam(2), p)) {
        return 2;
    }
    return 0;
}

void MB_Marker (int p, string name) {
    TechTreeUpgradeAddLevel(p, "MB_" + name, 1);
}

void MB_MarkerAll (string name) {
    int p;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0) {
            MB_Marker(p, name);
        }
    }
}

void MB_Say (playergroup players, text t) {
    UIDisplayMessage(players, c_messageAreaSubtitle, t);
}

int MB_RandomInRace (string race) {
    if (race == "Zerg") {
        return RandomInt(MB_ZERG_FIRST, MB_ZERG_LAST);
    }
    if (race == "Prot") {
        return RandomInt(MB_PROTOSS_FIRST, MB_PROTOSS_LAST);
    }
    return RandomInt(MB_TERRAN_FIRST, MB_TERRAN_LAST);
}

void MB_BuildTeams () {
    int t;
    int p;
    for (t = 1; t <= 2; t += 1) {
        gv_teamSize[t] = 0;
    }
    for (p = 1; p <= 8; p += 1) {
        t = MB_TeamOf(p);
        if (t != 0 && MB_IsPlaying(p) && gv_teamSize[t] < 4) {
            gv_teamSize[t] += 1;
            gv_teamPlayers[t][gv_teamSize[t]] = p;
        }
    }
}

//--------------------------------------------------------------------------------------------------
// Roster: index ranges by race (Zerg 1-13, Protoss 14-28, Terran 29-42) are relied on above.
//--------------------------------------------------------------------------------------------------
void MB_AddUnit (int i, string name, string label, string race, string icon) {
    gv_unitName[i] = name;
    gv_unitLabel[i] = label;
    gv_unitRace[i] = race;
    gv_unitIcon[i] = "Assets\\Textures\\btn-unit-" + icon + ".dds";
}

