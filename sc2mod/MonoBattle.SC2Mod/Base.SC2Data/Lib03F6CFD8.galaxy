        TechTreeUpgradeAllow(lp_player, "TerranVehicleAndShipWeaponsLevel2", true);
        TechTreeUpgradeAllow(lp_player, "TerranVehicleAndShipWeaponsLevel3", true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("RavenScramblerMissile", 0), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("RavenShredderMissile", 0), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("RavenRepairDrone", 0), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("BuildAutoTurret", 0), true);
        TechTreeUpgradeAllow(lp_player, "HunterSeeker", true);
        TechTreeUpgradeAllow(lp_player, "RavenCorvidReactor", true);
        TechTreeUpgradeAllow(lp_player, "DurableMaterials", true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("PlacePointDefenseDrone", 0), true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("SeekerMissile", 0), true);
        TechTreeUpgradeAllow(lp_player, "RavenDamageUpgrade", true);
    }
    else if (lp_name == "Battlecruiser") {
        TechTreeUnitAllow(lp_player, "Battlecruiser", true);
        TechTreeUpgradeAllow(lp_player, "TerranShipWeaponsLevel1", true);
        TechTreeUpgradeAllow(lp_player, "TerranShipWeaponsLevel2", true);
        TechTreeUpgradeAllow(lp_player, "TerranShipWeaponsLevel3", true);
        TechTreeUpgradeAllow(lp_player, "TerranVehicleAndShipWeaponsLevel1", true);
        TechTreeUpgradeAllow(lp_player, "TerranVehicleAndShipWeaponsLevel2", true);
        TechTreeUpgradeAllow(lp_player, "TerranVehicleAndShipWeaponsLevel3", true);
        TechTreeUpgradeAllow(lp_player, "BattlecruiserBehemothReactor", true);
        TechTreeUpgradeAllow(lp_player, "BattlecruiserEnableSpecializations", true);
    }
    else if (lp_name == "Viper") {
        TechTreeUnitAllow(lp_player, "Viper", true);
    }
}

// A morph pick's precursor can't stand in for it: its weapon is removed.
bool MB_OnUnitCreated (bool testConds, bool runActions) {
    unit u;
    string pick;
    u = EventUnitCreatedUnit();
    if (gv_phase != MB_PHASE_BATTLE || UnitGetOwner(u) < 1 || UnitGetOwner(u) > 8) {
        return true;
    }
    if (gv_pick[UnitGetOwner(u)] == 0) {
        return true;
    }
    pick = gv_unitName[gv_pick[UnitGetOwner(u)]];
    if (pick == "Baneling" && UnitGetType(u) == "Zergling") {
        UnitWeaponRemove(u, "Claws");
    }
    else if (pick == "Ravager" && UnitGetType(u) == "Roach") {
        UnitWeaponRemove(u, "AcidSaliva");
        UnitWeaponRemove(u, "RoachMelee");
    }
    else if (pick == "Lurker" && UnitGetType(u) == "Hydralisk") {
        UnitWeaponRemove(u, "HydraliskMelee");
        UnitWeaponRemove(u, "NeedleSpines");
    }
    else if (pick == "BroodLord" && UnitGetType(u) == "Corruptor") {
        UnitWeaponRemove(u, "ParasiteSpore");
    }
    else if (pick == "Archon" && UnitGetType(u) == "DarkTemplar") {
        UnitWeaponRemove(u, "WarpBlades");
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Pick panel, one per player, 1000 wide and as tall as the phase needs (MB_Layout), top to bottom:
//   title
//   up to 4 text buttons, centred (above the cards, or below them in the drafts)
//   unit cards, 4 per row, a short last row centred: icon (52) with its name on a 200-wide button
//     beneath, wide enough for "Hellion/Hellbat"
//   0-2 team strips: a unit icon and a player name per slot
//   one info line
// Clicking a card's icon or its name picks it. Taken units go grey; the current choice's name is
// green.
//--------------------------------------------------------------------------------------------------
const int MB_CARD_COLUMNS = 4;
const int MB_CARD_WIDTH = 200;
const int MB_CARD_GAP = 40;
const int MB_CARD_ICON = 52;
const int MB_OFFER_ICON = 32;     // Pick Three: allies' offers under the team strip
const int MB_CARD_NAME_HEIGHT = 36;  // shorter and the game reports names as too tall for a line
const int MB_CARD_PITCH = 96;   // icon, 4, name button, 4
const int MB_PANEL_WIDTH = 1000;

void MB_CreatePanel (int p) {
    int i;
    int r;
    int k;
    int c;
    gv_dialog[p] = DialogCreate(MB_PANEL_WIDTH, 750, c_anchorCenter, 0, 0, false);
    gv_title[p] = DialogControlCreate(gv_dialog[p], c_triggerControlTypeLabel);
    DialogControlSetSize(gv_title[p], PlayerGroupAll(), 920, 40);
    DialogControlSetPosition(gv_title[p], PlayerGroupAll(), c_anchorTopLeft, 40, 30);
    for (i = 1; i <= MB_TEXT_BUTTONS; i += 1) {
        c = DialogControlCreate(gv_dialog[p], c_triggerControlTypeButton);
        DialogControlSetSize(c, PlayerGroupAll(), 220, 52);
        DialogControlSetPosition(c, PlayerGroupAll(), c_anchorTopLeft, 36 + (i - 1) * 236, 80);
        DialogControlSetVisible(c, PlayerGroupAll(), false);
        gv_button[p][i] = c;
    }
    for (i = 1; i <= MB_CARDS; i += 1) {
        c = DialogControlCreate(gv_dialog[p], c_triggerControlTypeImage);
        DialogControlSetSize(c, PlayerGroupAll(), MB_CARD_ICON, MB_CARD_ICON);
        DialogControlSetVisible(c, PlayerGroupAll(), false);
        gv_cardImage[p][i] = c;
        c = DialogControlCreate(gv_dialog[p], c_triggerControlTypeButton);
        DialogControlSetSize(c, PlayerGroupAll(), MB_CARD_ICON, MB_CARD_ICON);
        DialogControlFadeTransparency(c, PlayerGroupAll(), 0.0, 100.0);
        DialogControlSetVisible(c, PlayerGroupAll(), false);
        gv_cardHotspot[p][i] = c;
        c = DialogControlCreate(gv_dialog[p], c_triggerControlTypeButton);
        DialogControlSetSize(c, PlayerGroupAll(), MB_CARD_WIDTH, MB_CARD_NAME_HEIGHT);
        DialogControlSetVisible(c, PlayerGroupAll(), false);
        gv_cardName[p][i] = c;
    }
    for (r = 1; r <= 2; r += 1) {
        for (k = 1; k <= 4; k += 1) {
            c = DialogControlCreate(gv_dialog[p], c_triggerControlTypeImage);
            DialogControlSetSize(c, PlayerGroupAll(), 44, 44);
            DialogControlSetPosition(c, PlayerGroupAll(), c_anchorTopLeft, 20 + (k - 1) * 240, 560 + (r - 1) * 64);
            DialogControlSetPropertyAsBool(c, c_triggerControlPropertyAcceptMouseTarget, PlayerGroupAll(), true);
            DialogControlSetVisible(c, PlayerGroupAll(), false);
            gv_stripIcon[p][r][k] = c;
            c = DialogControlCreate(gv_dialog[p], c_triggerControlTypeLabel);
            DialogControlSetSize(c, PlayerGroupAll(), 186, 28);
            DialogControlSetPosition(c, PlayerGroupAll(), c_anchorTopLeft, 70 + (k - 1) * 240, 570 + (r - 1) * 64);
            DialogControlSetVisible(c, PlayerGroupAll(), false);
            gv_stripName[p][r][k] = c;
        }
    }
    for (k = 1; k <= 4; k += 1) {
        for (i = 1; i <= 3; i += 1) {
            c = DialogControlCreate(gv_dialog[p], c_triggerControlTypeImage);
            DialogControlSetSize(c, PlayerGroupAll(), MB_OFFER_ICON, MB_OFFER_ICON);
            DialogControlSetPropertyAsBool(c, c_triggerControlPropertyAcceptMouseTarget, PlayerGroupAll(), true);
            DialogControlSetVisible(c, PlayerGroupAll(), false);
            gv_offerIcon[p][k][i] = c;
        }
    }
    gv_info[p] = DialogControlCreate(gv_dialog[p], c_triggerControlTypeLabel);
    DialogControlSetSize(gv_info[p], PlayerGroupAll(), 920, 30);
    DialogControlSetPosition(gv_info[p], PlayerGroupAll(), c_anchorTopLeft, 40, 700);
    DialogSetVisible(gv_dialog[p], PlayerGroupSingle(p), true);
}

// Fit the panel to a phase: `cards` unit cards, `stripRows` team strips, and the text buttons above
// the cards or (buttonsBelow) beneath them.
void MB_Layout (int p, int cards, int stripRows, bool buttonsBelow) {
    int y;
    int i;
    int r;
    int k;
    int row;
    int col;
    int inRow;
    int x;
    y = 80;
    if (!buttonsBelow) {
        for (i = 1; i <= MB_TEXT_BUTTONS; i += 1) {
            DialogControlSetPosition(gv_button[p][i], PlayerGroupAll(), c_anchorTopLeft, 36 + (i - 1) * 236, y);
        }
        y = y + 66;
    }
    for (i = 1; i <= cards; i += 1) {
        row = (i - 1) / MB_CARD_COLUMNS;
        col = ModI(i - 1, MB_CARD_COLUMNS);
        inRow = cards - row * MB_CARD_COLUMNS;
        if (inRow > MB_CARD_COLUMNS) {
            inRow = MB_CARD_COLUMNS;
        }
        x = (MB_PANEL_WIDTH - (inRow * MB_CARD_WIDTH + (inRow - 1) * MB_CARD_GAP)) / 2 + col * (MB_CARD_WIDTH + MB_CARD_GAP);
        DialogControlSetPosition(gv_cardImage[p][i], PlayerGroupAll(), c_anchorTopLeft, x + (MB_CARD_WIDTH - MB_CARD_ICON) / 2, y + row * MB_CARD_PITCH);
        DialogControlSetPosition(gv_cardHotspot[p][i], PlayerGroupAll(), c_anchorTopLeft, x + (MB_CARD_WIDTH - MB_CARD_ICON) / 2, y + row * MB_CARD_PITCH);
        DialogControlSetPosition(gv_cardName[p][i], PlayerGroupAll(), c_anchorTopLeft, x, y + row * MB_CARD_PITCH + MB_CARD_ICON + 4);
    }
    if (cards > 0) {
        y = y + ((cards + MB_CARD_COLUMNS - 1) / MB_CARD_COLUMNS) * MB_CARD_PITCH + 8;
    }
    if (buttonsBelow) {
        // Below the cards there is one button (2: Confirm, or who we're waiting for), centred.
        DialogControlSetPosition(gv_button[p][2], PlayerGroupAll(), c_anchorTopLeft, (MB_PANEL_WIDTH - 220) / 2, y);
        y = y + 66;
    }
    for (r = 1; r <= 2; r += 1) {
        for (k = 1; k <= 4; k += 1) {
            DialogControlSetPosition(gv_stripIcon[p][r][k], PlayerGroupAll(), c_anchorTopLeft, 20 + (k - 1) * 240, y + (r - 1) * 64);
            DialogControlSetPosition(gv_stripName[p][r][k], PlayerGroupAll(), c_anchorTopLeft, 70 + (k - 1) * 240, y + 10 + (r - 1) * 64);
        }
    }
    for (k = 1; k <= 4; k += 1) {
        for (i = 1; i <= 3; i += 1) {
            DialogControlSetPosition(gv_offerIcon[p][k][i], PlayerGroupAll(), c_anchorTopLeft,
                20 + (k - 1) * 240 + (i - 1) * (MB_OFFER_ICON + 6), y + 50);
        }
    }
    y = y + stripRows * 64;
    if (gv_phase == MB_PHASE_PICK_THREE) {
        y = y + MB_OFFER_ICON + 8;  // the offer icons under the strip
    }
    DialogControlSetPosition(gv_info[p], PlayerGroupAll(), c_anchorTopLeft, 40, y);
    DialogSetSize(gv_dialog[p], MB_PANEL_WIDTH, y + 50);
}

void MB_SetTitle (int p, text t) {
    DialogControlSetPropertyAsText(gv_title[p], c_triggerControlPropertyText, PlayerGroupSingle(p), t);
}

void MB_SetInfo (int p, text t) {
    DialogControlSetPropertyAsText(gv_info[p], c_triggerControlPropertyText, PlayerGroupSingle(p), t);
}

void MB_SetButtonText (int p, int i, text label, bool enabled) {
    DialogControlSetPropertyAsText(gv_button[p][i], c_triggerControlPropertyText, PlayerGroupSingle(p), label);
    DialogControlSetEnabled(gv_button[p][i], PlayerGroupSingle(p), enabled);
    DialogControlSetVisible(gv_button[p][i], PlayerGroupSingle(p), true);
}

void MB_SetButton (int p, int i, string label, bool enabled) {
    MB_SetButtonText(p, i, MB_Text(label), enabled);
}

void MB_HideButtons (int p) {
    int i;
    for (i = 1; i <= MB_TEXT_BUTTONS; i += 1) {
        DialogControlSetVisible(gv_button[p][i], PlayerGroupSingle(p), false);
    }
}

const int MB_CARD_PICKABLE = 1;
const int MB_CARD_CHOSEN = 2;   // pickable, and the current choice
const int MB_CARD_TAKEN = 3;    // grey, not pickable
const int MB_CARD_SHOWN = 4;    // in colour, not pickable (someone else's turn, a rolled unit)

void MB_SetCard (int p, int i, int u, int state) {
    playergroup g;
    text name;
    g = PlayerGroupSingle(p);
    name = MB_Text(gv_unitLabel[u]);
    if (state == MB_CARD_CHOSEN) {
        name = TextWithColor(name, Color(40, 100, 40));
    }
    DialogControlSetPropertyAsString(gv_cardImage[p][i], c_triggerControlPropertyImage, g, gv_unitIcon[u]);
    DialogControlSetPropertyAsBool(gv_cardImage[p][i], c_triggerControlPropertyDesaturated, g, state == MB_CARD_TAKEN);
    DialogControlSetPropertyAsText(gv_cardHotspot[p][i], c_triggerControlPropertyTooltip, g, MB_Text(gv_unitLabel[u]));
    DialogControlSetPropertyAsText(gv_cardName[p][i], c_triggerControlPropertyText, g, name);
    DialogControlSetEnabled(gv_cardHotspot[p][i], g, state == MB_CARD_PICKABLE || state == MB_CARD_CHOSEN);
    DialogControlSetEnabled(gv_cardName[p][i], g, state == MB_CARD_PICKABLE || state == MB_CARD_CHOSEN);
    DialogControlSetVisible(gv_cardImage[p][i], g, true);
    DialogControlSetVisible(gv_cardHotspot[p][i], g, true);
    DialogControlSetVisible(gv_cardName[p][i], g, true);
}

void MB_HideCards (int p) {
    int i;
    for (i = 1; i <= MB_CARDS; i += 1) {
        DialogControlSetVisible(gv_cardImage[p][i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(gv_cardHotspot[p][i], PlayerGroupSingle(p), false);
        DialogControlSetVisible(gv_cardName[p][i], PlayerGroupSingle(p), false);
    }
}

// One slot of a team strip: a unit icon (a question mark for none) and a name.
void MB_SetStrip (int p, int r, int k, int u, text name) {
    playergroup g;
    g = PlayerGroupSingle(p);
    if (u != 0) {
        DialogControlSetPropertyAsString(gv_stripIcon[p][r][k], c_triggerControlPropertyImage, g, gv_unitIcon[u]);
        DialogControlSetPropertyAsText(gv_stripIcon[p][r][k], c_triggerControlPropertyTooltip, g, MB_Text(gv_unitLabel[u]));
    }
    else {
        DialogControlSetPropertyAsString(gv_stripIcon[p][r][k], c_triggerControlPropertyImage, g, "Assets\\Textures\\ui_tip_questionmark.dds");
        DialogControlSetPropertyAsText(gv_stripIcon[p][r][k], c_triggerControlPropertyTooltip, g, MB_Text("Not picked yet"));
    }
    DialogControlSetPropertyAsText(gv_stripName[p][r][k], c_triggerControlPropertyText, g, name);
    DialogControlSetVisible(gv_stripIcon[p][r][k], g, true);
    DialogControlSetVisible(gv_stripName[p][r][k], g, true);
}

void MB_HideStrips (int p) {
    int r;
    int k;
    for (r = 1; r <= 2; r += 1) {
        for (k = 1; k <= 4; k += 1) {
            DialogControlSetVisible(gv_stripIcon[p][r][k], PlayerGroupSingle(p), false);
            DialogControlSetVisible(gv_stripName[p][r][k], PlayerGroupSingle(p), false);
        }
    }
    for (k = 1; k <= 4; k += 1) {
        for (r = 1; r <= 3; r += 1) {
            DialogControlSetVisible(gv_offerIcon[p][k][r], PlayerGroupSingle(p), false);
        }
    }
}

void MB_TitleAll (text t) {
    int p;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0) {
            MB_SetTitle(p, t);
        }
    }
    MB_ObserverTitle(t);
}

int MB_ButtonIndex (int p, int control) {
    int i;
    for (i = 1; i <= MB_TEXT_BUTTONS; i += 1) {
        if (gv_button[p][i] == control) {
            return i;
        }
    }
    return 0;
}

int MB_CardIndex (int p, int control) {
    int i;
    for (i = 1; i <= MB_CARDS; i += 1) {
        if (gv_cardHotspot[p][i] == control || gv_cardName[p][i] == control) {
            return i;
        }
    }
    return 0;
}

text MB_Name (int p) {
    if (p == 0) {
        return MB_Text("nobody");
    }
    return PlayerName(p);
}

//--------------------------------------------------------------------------------------------------
// Mode vote
//--------------------------------------------------------------------------------------------------
string MB_ModeName (int mode) {
    if (mode == MB_MODE_BLIND) {
        return "Blind Random";
    }
    if (mode == MB_MODE_SINGLE) {
        return "Single Draft";
    }
    if (mode == MB_MODE_PICK_THREE) {
        return "Pick Three";
    }
    return "Captains Draft";
}

string MB_ModeMarker (int mode) {
    if (mode == MB_MODE_BLIND) {
        return "Mode_Blind";
    }
    if (mode == MB_MODE_SINGLE) {
        return "Mode_Single";
    }
    if (mode == MB_MODE_PICK_THREE) {
        return "Mode_PickThree";
    }
    return "Mode_Captains";
}

int MB_VoteCount (int mode) {
    int p;
    int n;
    n = 0;
    for (p = 1; p <= 8; p += 1) {
        if (gv_vote[p] == mode) {
            n += 1;
        }
    }
    return n;
}

void MB_ShowVotes () {
    int p;
    int m;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0) {
            MB_Layout(p, 0, 0, false);
            for (m = 1; m <= 4; m += 1) {
                MB_SetButton(p, m, MB_ModeName(m) + " (" + IntToString(MB_VoteCount(m)) + ")", true);
            }
        }
    }
}

bool MB_AllVoted () {
    int p;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0 && MB_IsPlaying(p) && gv_vote[p] == 0) {
            return false;
        }
    }
    return true;
}

// Everyone still in has locked in their pick: the pick phase can end early.
bool MB_AllLocked () {
    int p;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0 && MB_IsPlaying(p) && !gv_locked[p]) {
            return false;
        }
    }
    return true;
}

// Most votes wins; ties (including nobody voting) are broken at random.
int MB_VoteResult () {
    int best;
    int m;
    int[5] tied;
    int n;
    best = 0;
    for (m = 1; m <= 4; m += 1) {
        if (MB_VoteCount(m) > best) {
            best = MB_VoteCount(m);
        }
    }
    n = 0;
    for (m = 1; m <= 4; m += 1) {
        if (MB_VoteCount(m) == best) {
            n += 1;
            tied[n] = m;
        }
    }
    return tied[RandomInt(1, n)];
}

// The host's "Pick mode" lobby setting (Attributes, id 1): 0 = vote in game.
int MB_LobbyMode () {
    string value;
    value = GameAttributeGameValue("1");
    if (value == "0002") {
        return MB_MODE_BLIND;
    }
    if (value == "0003") {
        return MB_MODE_SINGLE;
    }
    if (value == "0004") {
        return MB_MODE_PICK_THREE;
    }
    if (value == "0005") {
        return MB_MODE_CAPTAINS;
    }
    return 0;
}

void MB_RunVote () {
    int left;
    gv_phase = MB_PHASE_VOTE;
    MB_ShowVotes();
    MB_RefreshInfo();
    left = MB_VOTE_SECONDS;
    while (left > 0 && !MB_AllVoted()) {
        MB_TitleAll(MB_Text("Vote for a mode - " + IntToString(left) + " s"));
        Wait(1.0, c_timeReal);
        left -= 1;
    }
    gv_mode = MB_VoteResult();
    MB_MarkerAll(MB_ModeMarker(gv_mode));
    MB_Say(PlayerGroupAll(), MB_Text(MB_ModeName(gv_mode) + " it is."));
}

//--------------------------------------------------------------------------------------------------
// Blind Random: everyone rolls at once. Choosing the Random race allows one repick, which always
// lands on a different unit. Each roll is an MB_Offer, so MonoBot sees repicks.
//--------------------------------------------------------------------------------------------------
void MB_Roll (int p, int raceChoice) {
    int u;
    u = gv_pick[p];
    while (u == gv_pick[p]) {
        if (raceChoice == 2) {
            u = MB_RandomInRace("Terr");
        }
        else if (raceChoice == 3) {
            u = MB_RandomInRace("Zerg");
        }
        else if (raceChoice == 4) {
            u = MB_RandomInRace("Prot");
        }
        else {
            u = RandomInt(1, MB_UNITS);
        }
    }
    if (gv_rolls[p] == 0) {
        gv_firstRoll[p] = u;
    }
    gv_pick[p] = u;
    gv_rolls[p] += 1;
    MB_Marker(p, "Offer_" + gv_unitName[u]);
}

// Race buttons until the roll; then the rolled unit as a single centred card.
void MB_BlindButtons (int p) {
    MB_HideButtons(p);
    MB_HideCards(p);
    if (gv_rolls[p] == 0) {
        MB_Layout(p, 0, 1, false);
        MB_SetButton(p, 1, "Random + repick", true);
        MB_SetButton(p, 2, "Terran", true);
        MB_SetButton(p, 3, "Zerg", true);
        MB_SetButton(p, 4, "Protoss", true);
        return;
    }
    MB_Layout(p, 1, 1, false);
    MB_SetCard(p, 1, gv_pick[p], MB_CARD_SHOWN);
    if (gv_locked[p]) {
        MB_SetButton(p, 2, "Locked in", false);
    }
    else {
        MB_SetButton(p, 2, "Repick", true);
        MB_SetButton(p, 3, "Lock in", true);
    }
}

// Text button i: before the roll, 1 Random, 2 Terran, 3 Zerg, 4 Protoss; after, 2 Repick, 3 Lock in.
void MB_BlindClick (int p, int i) {
    if (gv_locked[p]) {
        return;
    }
    if (gv_rolls[p] == 0) {
        MB_Roll(p, i);
        gv_locked[p] = (i != 1);
    }
    else if (i == 2) {
        MB_Roll(p, 1);
        gv_locked[p] = true;
    }
    else if (i == 3) {
        gv_locked[p] = true;
    }
    MB_BlindButtons(p);
    MB_RefreshInfo();
}

void MB_RunBlind () {
    int p;
    int left;
    gv_phase = MB_PHASE_BLIND;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0) {
            MB_BlindButtons(p);
        }
    }
    MB_RefreshInfo();
    left = MB_BLIND_SECONDS;
    while (left > 0 && !MB_AllLocked()) {
        MB_TitleAll(MB_Text("Blind Random - " + IntToString(left) + " s"));
        Wait(1.0, c_timeReal);
        left -= 1;
    }
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0 && gv_rolls[p] == 0) {
            MB_Roll(p, 1);
        }
        gv_locked[p] = true;
    }
}

//--------------------------------------------------------------------------------------------------
// Pick Three: each player is offered one unit per race, never the same unit twice in a team, and
// picks one. Everyone picks at once; allies see each other's offers and choices, enemies nothing.
//--------------------------------------------------------------------------------------------------
int MB_DrawForTeam (string race) {
    int u;
    u = MB_RandomInRace(race);
    while (gv_used[u]) {
        u = MB_RandomInRace(race);
    }
    gv_used[u] = true;
    return u;
}

void MB_DealOffers (int t) {
    int k;
    int p;
    int i;
    for (i = 1; i <= MB_UNITS; i += 1) {
        gv_used[i] = false;
    }
    for (k = 1; k <= gv_teamSize[t]; k += 1) {
        p = gv_teamPlayers[t][k];
        gv_offer[p][1] = MB_DrawForTeam("Zerg");
        gv_offer[p][2] = MB_DrawForTeam("Prot");
        gv_offer[p][3] = MB_DrawForTeam("Terr");
        for (i = 1; i <= 3; i += 1) {
            MB_Marker(p, "Offer_" + gv_unitName[gv_offer[p][i]]);
        }
    }
}

// The offers are three centred cards, the choice in green; one text button locks it in.
void MB_PickThreeButtons (int p) {
    int i;
    int state;
    MB_Layout(p, 3, 1, false);
    MB_HideButtons(p);
    MB_HideCards(p);
    for (i = 1; i <= 3; i += 1) {
        if (gv_locked[p]) {
            state = MB_CARD_SHOWN;
            if (gv_pick[p] == gv_offer[p][i]) {
                state = MB_CARD_CHOSEN;
            }
        }
        else if (gv_pick[p] == gv_offer[p][i]) {
            state = MB_CARD_CHOSEN;
        }
        else {
            state = MB_CARD_PICKABLE;
        }
        MB_SetCard(p, i, gv_offer[p][i], state);
    }
    if (gv_locked[p]) {
        for (i = 1; i <= 3; i += 1) {
            DialogControlSetEnabled(gv_cardHotspot[p][i], PlayerGroupSingle(p), false);
            DialogControlSetEnabled(gv_cardName[p][i], PlayerGroupSingle(p), false);
        }
        MB_SetButton(p, 2, "Locked in", false);
    }
    else {
        MB_SetButton(p, 2, "Lock in", gv_pick[p] != 0);
    }
}

void MB_PickThreeClick (int p, int card, int button) {
    if (gv_locked[p] || gv_offer[p][1] == 0) {
        return;
    }
    if (card >= 1 && card <= 3) {
        gv_pick[p] = gv_offer[p][card];
    }
    else if (button == 2 && gv_pick[p] != 0) {
        gv_locked[p] = true;
    }
    else {
        return;
    }
    MB_PickThreeButtons(p);
    MB_RefreshInfo();
}

void MB_RunPickThree () {
    int k;
    int t;
    int p;
    int left;
    gv_phase = MB_PHASE_PICK_THREE;
    for (t = 1; t <= 2; t += 1) {
        MB_DealOffers(t);
        for (k = 1; k <= gv_teamSize[t]; k += 1) {
            MB_PickThreeButtons(gv_teamPlayers[t][k]);
        }
    }
    MB_RefreshInfo();
    left = MB_PICK_THREE_SECONDS;
    while (left > 0 && !MB_AllLocked()) {
        MB_TitleAll(MB_Text("Pick Three - " + IntToString(left) + " s"));
        Wait(1.0, c_timeReal);
        left -= 1;
    }
    for (p = 1; p <= 8; p += 1) {
        if (gv_offer[p][1] != 0 && gv_pick[p] == 0) {
            gv_pick[p] = gv_offer[p][RandomInt(1, 3)];
        }
        gv_locked[p] = true;
    }
}

//--------------------------------------------------------------------------------------------------
// Drafts: a pool of 20 units drawn from all 42, shared by both teams.
//--------------------------------------------------------------------------------------------------
void MB_DealPool () {
    int[43] deck;
    int i;
    int j;
    int swap;
    for (i = 1; i <= MB_UNITS; i += 1) {
        deck[i] = i;
    }
    for (i = 1; i <= MB_POOL_SIZE; i += 1) {
        j = RandomInt(i, MB_UNITS);
        swap = deck[i];
        deck[i] = deck[j];
        deck[j] = swap;
        gv_pool[i] = deck[i];
        gv_poolTaken[i] = false;
    }
}

// The pool as 20 cards: taken units grey; whoever's turn it is selects one (green) and confirms it
// with the button beneath, everyone else waits.
void MB_PoolButtons () {
    int p;
    int i;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0) {
            MB_Layout(p, MB_POOL_SIZE, 2, true);
            MB_HideButtons(p);
            for (i = 1; i <= MB_POOL_SIZE; i += 1) {
                if (gv_poolTaken[i]) {
                    MB_SetCard(p, i, gv_pool[i], MB_CARD_TAKEN);
                }
                else if (p != gv_turnPlayer) {
                    MB_SetCard(p, i, gv_pool[i], MB_CARD_SHOWN);
                }
                else if (i == gv_draftSelected) {
                    MB_SetCard(p, i, gv_pool[i], MB_CARD_CHOSEN);
                }
                else {
                    MB_SetCard(p, i, gv_pool[i], MB_CARD_PICKABLE);
                }
            }
            if (gv_turnPlayer == 0) {
                continue;
            }
            if (p == gv_turnPlayer) {
                MB_SetButton(p, 2, "Confirm pick", gv_draftSelected != 0);
            }
            else {
                MB_SetButtonText(p, 2, MB_Text("Waiting for ") + MB_Name(gv_turnPlayer), false);
            }
        }
    }
}

int MB_RandomFreeSlot () {
    int i;
    i = RandomInt(1, MB_POOL_SIZE);
    while (gv_poolTaken[i]) {
        i = RandomInt(1, MB_POOL_SIZE);
    }
    return i;
}

// Turn order A-B-B-A-A-B-B-A by team, players shuffled within each team; the first team is random.
// One turn per player; in Captains Draft every one of a team's turns is its captain's.
void MB_BuildOrder (bool captainsOnly) {
    int first;
    int[9] pattern;
    int[3] next;
    int[3][5] shuffled;
    int t;
    int k;
    int j;
    int swap;
    int n;
    first = RandomInt(1, 2);
    pattern[1] = first;
    pattern[2] = 3 - first;
    pattern[3] = 3 - first;
    pattern[4] = first;
    pattern[5] = first;
    pattern[6] = 3 - first;
    pattern[7] = 3 - first;
    pattern[8] = first;
    for (t = 1; t <= 2; t += 1) {
        next[t] = 1;
        for (k = 1; k <= gv_teamSize[t]; k += 1) {
            shuffled[t][k] = gv_teamPlayers[t][k];
        }
        for (k = 1; k <= gv_teamSize[t]; k += 1) {
            j = RandomInt(k, gv_teamSize[t]);
            swap = shuffled[t][k];
            shuffled[t][k] = shuffled[t][j];
            shuffled[t][j] = swap;
        }
    }
    gv_orderCount = 0;
    for (n = 1; n <= 8; n += 1) {
        t = pattern[n];
        if (next[t] <= gv_teamSize[t]) {
            gv_orderCount += 1;
            if (captainsOnly) {
                gv_order[gv_orderCount] = gv_captain[t];
            }
            else {
                gv_order[gv_orderCount] = shuffled[t][next[t]];
            }
            next[t] += 1;
        }
    }
}

// The current turn takes pool slot i.
void MB_TakeSlot (int i) {
    int p;
    int t;
    p = gv_turnPlayer;
    gv_poolTaken[i] = true;
    if (gv_mode == MB_MODE_SINGLE) {
        gv_pick[p] = gv_pool[i];
        gv_locked[p] = true;
    }
    else {
        t = MB_TeamOf(p);
        gv_teamUnitCount[t] += 1;
        gv_teamUnits[t][gv_teamUnitCount[t]] = gv_pool[i];
        MB_Marker(p, "Draft_" + gv_unitName[gv_pool[i]]);
    }
    gv_turnDone = true;
}

// A card selects (and can be changed); the Confirm button takes it.
void MB_DraftClick (int p, int card, int button) {
    if (p != gv_turnPlayer || gv_turnDone) {
        return;
    }
    if (card >= 1 && card <= MB_POOL_SIZE && !gv_poolTaken[card]) {
        gv_draftSelected = card;
    }
    else if (button == 2 && gv_draftSelected != 0) {
        MB_TakeSlot(gv_draftSelected);
    }
    else {
        return;
    }
    MB_PoolButtons();
}

void MB_RunDraftTurns (string modeName) {
    int n;
    int left;
    for (n = 1; n <= gv_orderCount; n += 1) {
        gv_turnPlayer = gv_order[n];
        gv_turnDone = false;
        gv_draftSelected = 0;
        MB_PoolButtons();
        MB_RefreshInfo();
        left = MB_DRAFT_TURN_SECONDS;
        while (left > 0 && !gv_turnDone) {
            MB_TitleAll(MB_Text(modeName + " - ") + MB_Name(gv_turnPlayer) + MB_Text("'s turn - " + IntToString(left) + " s"));
            Wait(1.0, c_timeReal);
            left -= 1;
        }
        if (!gv_turnDone && gv_draftSelected != 0) {
            MB_TakeSlot(gv_draftSelected);  // timed out: the selected unit, as on the old map
        }
        else if (!gv_turnDone) {
            MB_TakeSlot(MB_RandomFreeSlot());
        }
    }
    gv_turnPlayer = 0;
    MB_PoolButtons();
}

void MB_RunSingle () {
    gv_phase = MB_PHASE_SINGLE;
    MB_DealPool();
    MB_BuildOrder(false);
    MB_RunDraftTurns("Single Draft");
}

//--------------------------------------------------------------------------------------------------
// Captains Draft: volunteers become captains; captains draft their team's units from the shared
// pool in snake order, then hand them out to their players.
//--------------------------------------------------------------------------------------------------
// A random volunteer still in the game, else a random player still in, else anyone on the team
// (a captain who has left would leave the whole team's draft to chance).
void MB_ChooseCaptains () {
    int t;
    int k;
    int p;
    int n;
    int m;
    int[5] volunteers;
    int[5] present;
    for (t = 1; t <= 2; t += 1) {
        n = 0;
        m = 0;
        for (k = 1; k <= gv_teamSize[t]; k += 1) {
            p = gv_teamPlayers[t][k];
            if (MB_IsPlaying(p)) {
                m += 1;
                present[m] = p;
                if (gv_optIn[p]) {
                    n += 1;
                    volunteers[n] = p;
                }
            }
        }
        if (n > 0) {
            gv_captain[t] = volunteers[RandomInt(1, n)];
        }
        else if (m > 0) {
            gv_captain[t] = present[RandomInt(1, m)];
        }
        else if (gv_teamSize[t] > 0) {
            gv_captain[t] = gv_teamPlayers[t][RandomInt(1, gv_teamSize[t])];
        }
        if (gv_captain[t] != 0) {
            MB_Marker(gv_captain[t], "Captain");
        }
    }
}

// The team's drafted units as cards for the whole team; the captain can pick one (green), then a
// "To <player>" text button to hand it over. Who holds what shows in the team strip.
void MB_AssignButtons (int t) {
    int c;
    int s;
    int k;
    int q;
    c = gv_captain[t];
    for (k = 1; k <= gv_teamSize[t]; k += 1) {
        q = gv_teamPlayers[t][k];
        MB_Layout(q, gv_teamUnitCount[t], 1, false);
        MB_HideButtons(q);
        MB_HideCards(q);
        for (s = 1; s <= gv_teamUnitCount[t]; s += 1) {
            if (q != c) {
                MB_SetCard(q, s, gv_teamUnits[t][s], MB_CARD_SHOWN);
            }
            else if (gv_selectedSlot[t] == s) {
                MB_SetCard(q, s, gv_teamUnits[t][s], MB_CARD_CHOSEN);
            }
            else {
                MB_SetCard(q, s, gv_teamUnits[t][s], MB_CARD_PICKABLE);
            }
        }
    }
    if (c == 0) {
        return;
    }
    for (k = 1; k <= gv_teamSize[t]; k += 1) {
        MB_SetButtonText(c, k, MB_Text("To ") + MB_Name(gv_teamPlayers[t][k]), gv_selectedSlot[t] != 0);
    }
}

void MB_AssignClick (int p, int card, int button) {
    int t;
    int s;
    int target;
    t = MB_TeamOf(p);
    if (t == 0 || p != gv_captain[t]) {
        return;
    }
    if (card >= 1 && card <= gv_teamUnitCount[t]) {
        gv_selectedSlot[t] = card;
    }
    else if (button >= 1 && button <= gv_teamSize[t] && gv_selectedSlot[t] != 0) {
        target = gv_teamPlayers[t][button];
        for (s = 1; s <= gv_teamUnitCount[t]; s += 1) {
            if (gv_assignee[t][s] == target) {
                gv_assignee[t][s] = 0;  // a player holds one unit; reassigning frees the old one
            }
        }
        gv_assignee[t][gv_selectedSlot[t]] = target;
        gv_selectedSlot[t] = 0;
    }
    else {
        return;
    }
    MB_AssignButtons(t);
    MB_RefreshInfo();
}

bool MB_Holds (int t, int p) {
    int s;
    for (s = 1; s <= gv_teamUnitCount[t]; s += 1) {
        if (gv_assignee[t][s] == p) {
            return true;
        }
    }
    return false;
}

// Unassigned units go to players without one, at random.
void MB_FinishAssignment (int t) {
    int s;
    int k;
    int p;
    int n;
    int[5] free;
    n = 0;
    for (k = 1; k <= gv_teamSize[t]; k += 1) {
        if (!MB_Holds(t, gv_teamPlayers[t][k])) {
            n += 1;
            free[n] = gv_teamPlayers[t][k];
        }
    }
    for (s = 1; s <= gv_teamUnitCount[t]; s += 1) {
        if (gv_assignee[t][s] == 0 && n > 0) {
            k = RandomInt(1, n);
            gv_assignee[t][s] = free[k];
            free[k] = free[n];
            n -= 1;
        }
        p = gv_assignee[t][s];
        if (p != 0) {
            gv_pick[p] = gv_teamUnits[t][s];
            gv_locked[p] = true;
        }
    }
}

void MB_RunCaptains () {
    int p;
    int t;
    int left;
    gv_phase = MB_PHASE_OPT_IN;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0) {
            MB_Layout(p, 0, 0, false);
            MB_HideButtons(p);
            MB_HideCards(p);
            MB_SetButton(p, 2, "I'll captain", true);
        }
    }
    MB_RefreshInfo();
    left = MB_OPT_IN_SECONDS;
    while (left > 0) {
        MB_TitleAll(MB_Text("Captains Draft - volunteer to captain - " + IntToString(left) + " s"));
        Wait(1.0, c_timeReal);
        left -= 1;
    }
    MB_ChooseCaptains();
    MB_Say(PlayerGroupAll(), MB_Text("Captains: ") + MB_Name(gv_captain[1]) + MB_Text(" and ") + MB_Name(gv_captain[2]));

    gv_phase = MB_PHASE_CAPTAIN_DRAFT;
    MB_DealPool();
    MB_BuildOrder(true);
    MB_RunDraftTurns("Captains Draft");

    gv_phase = MB_PHASE_ASSIGN;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0) {
            MB_HideButtons(p);
        }
    }
    for (t = 1; t <= 2; t += 1) {
        MB_AssignButtons(t);
    }
    MB_RefreshInfo();
    left = MB_ASSIGN_SECONDS;
    while (left > 0) {
        MB_TitleAll(MB_Text("Captains assign units - " + IntToString(left) + " s"));
        Wait(1.0, c_timeReal);
        left -= 1;
    }
    for (t = 1; t <= 2; t += 1) {
        MB_FinishAssignment(t);
    }
}

//--------------------------------------------------------------------------------------------------
// Info line: what each player may see right now.
//--------------------------------------------------------------------------------------------------
text MB_DraftLines () {
    text s;
    string line;
    int t;
    int k;
    s = MB_Text("");
    for (t = 1; t <= 2; t += 1) {
        line = "Team " + IntToString(t) + ": ";
        for (k = 1; k <= gv_teamUnitCount[t]; k += 1) {
            line = line + gv_unitLabel[gv_teamUnits[t][k]] + "  ";
        }
        s = s + MB_Text(line + "<n/>");
    }
    return s;
}

text MB_AssignLines (int t) {
    text s;
    int k;
    s = MB_Text("");
    for (k = 1; k <= gv_teamUnitCount[t]; k += 1) {
        s = s + MB_Text(gv_unitLabel[gv_teamUnits[t][k]]);
        if (gv_assignee[t][k] != 0) {
            s = s + MB_Text(" -> ") + MB_Name(gv_assignee[t][k]);
        }
        s = s + MB_Text("<n/>");
    }
    return s;
}

text MB_SingleLines () {
    text s;
    int n;
    int p;
    s = MB_Text("");
    for (n = 1; n <= gv_orderCount; n += 1) {
        p = gv_order[n];
        s = s + MB_Name(p) + MB_Text(" (team " + IntToString(MB_TeamOf(p)) + "): ");
        if (gv_pick[p] != 0) {
            s = s + MB_Text(gv_unitLabel[gv_pick[p]]);
        }
        s = s + MB_Text("<n/>");
    }
    return s;
}

//--------------------------------------------------------------------------------------------------
// Observer panel: everyone in the game who isn't on a team (observers, and whoever else holds a
// slot without a team) sees the whole pick phase as it happens, both teams, nothing hidden. It
// closes at battle start, where the picks panel takes over.
//--------------------------------------------------------------------------------------------------
void MB_CreateObserverPanel () {
    int p;
    gv_observers = PlayerGroupEmpty();
    // Every number not on a team: observers are spectator-type players, but which numbers they get
    // is unproven.
    for (p = 0; p <= 15; p += 1) {
        if (MB_TeamOf(p) == 0) {
            PlayerGroupAdd(gv_observers, p);
        }
    }
    if (PlayerGroupCount(gv_observers) == 0) {
        return;
    }
    gv_obsDialog = DialogCreate(560, 460, c_anchorTopRight, 10, 60, false);
    gv_obsTitle = DialogControlCreate(gv_obsDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(gv_obsTitle, PlayerGroupAll(), 520, 36);
    DialogControlSetPosition(gv_obsTitle, PlayerGroupAll(), c_anchorTopLeft, 20, 20);
    gv_obsInfo = DialogControlCreate(gv_obsDialog, c_triggerControlTypeLabel);
    DialogControlSetSize(gv_obsInfo, PlayerGroupAll(), 520, 390);
    DialogControlSetPosition(gv_obsInfo, PlayerGroupAll(), c_anchorTopLeft, 20, 60);
    // An observer sees it by their own number, not by the player whose vision they follow.
    DialogSetObservedType(gv_obsDialog, c_triggerObservedTypeSelectedOrObservedPlayerId);
    DialogSetVisible(gv_obsDialog, gv_observers, true);
}

// Temporary: two labels per player number not on a team, each shown only to that number, for the
// whole game: "own" by the viewer's own number, "followed" by the default (the followed player's).
// Which an observer or replay viewer sees shows how their view is addressed.
void MB_ObserverProbe () {
    int p;
    int k;
    int d;
    int c;
    string how;
    for (p = 0; p <= 15; p += 1) {
        if (MB_TeamOf(p) == 0) {
            for (k = 0; k <= 1; k += 1) {
                how = "followed";
                if (k == 0) {
                    how = "own";
                }
                d = DialogCreate(380, 40, c_anchorTopRight, 580 + k * 390, 60 + p * 42, false);
                DialogSetImageVisible(d, false);
                c = DialogControlCreate(d, c_triggerControlTypeLabel);
                DialogControlSetSize(c, PlayerGroupAll(), 360, 30);
                DialogControlSetPosition(c, PlayerGroupAll(), c_anchorTopLeft, 10, 5);
                DialogControlSetPropertyAsText(c, c_triggerControlPropertyText, PlayerGroupAll(),
                    MB_Text("probe " + IntToString(p) + " " + how + ": status " + IntToString(PlayerStatus(p))
                        + ", type " + IntToString(PlayerType(p))));
                if (k == 0) {
                    DialogSetObservedType(d, c_triggerObservedTypeSelectedOrObservedPlayerId);
                }
                DialogSetVisible(d, PlayerGroupSingle(p), true);
            }
        }
    }
}

void MB_ObserverTitle (text t) {
    if (gv_obsDialog != 0) {
        DialogControlSetPropertyAsText(gv_obsTitle, c_triggerControlPropertyText, gv_observers, t);
    }
}

// One player's state in the vote, Blind Random, Pick Three or the captain opt-in.
text MB_ObserverLine (int p) {
    string s;
    s = ": ";
    if (gv_phase == MB_PHASE_VOTE) {
        if (gv_vote[p] != 0) {
            s = s + "votes " + MB_ModeName(gv_vote[p]);
        }
        else {
            s = s + "-";
        }
    }
    else if (gv_phase == MB_PHASE_BLIND) {
        if (gv_rolls[p] == 0) {
            s = s + "choosing a race";
        }
        else if (gv_rolls[p] > 1) {
            s = s + gv_unitLabel[gv_firstRoll[p]] + " -> " + gv_unitLabel[gv_pick[p]] + " (repick)";
        }
        else {
            s = s + gv_unitLabel[gv_pick[p]];
            if (!gv_locked[p]) {
                s = s + " (may repick)";
            }
        }
    }
    else if (gv_phase == MB_PHASE_PICK_THREE && gv_offer[p][1] != 0) {
        s = s + gv_unitLabel[gv_offer[p][1]] + " / " + gv_unitLabel[gv_offer[p][2]] + " / " + gv_unitLabel[gv_offer[p][3]];
        if (gv_pick[p] != 0) {
            s = s + " -> " + gv_unitLabel[gv_pick[p]];
            if (gv_locked[p]) {
                s = s + " (locked)";
            }
        }
    }
    else if (gv_phase == MB_PHASE_PREVIEW) {
        s = s + gv_unitLabel[gv_pick[p]];
    }
    else if (gv_phase == MB_PHASE_OPT_IN) {
        if (gv_optIn[p]) {
            s = s + "volunteered";
        }
        else {
            s = s + "-";
        }
    }
    return MB_Name(p) + MB_Text(s + "<n/>");
}

void MB_RefreshObserver () {
    text s;
    int t;
    int k;
    if (gv_obsDialog == 0) {
        return;
    }
    s = MB_Text("");
    if (gv_phase == MB_PHASE_SINGLE) {
        s = MB_SingleLines();
    }
    else if (gv_phase == MB_PHASE_CAPTAIN_DRAFT) {
        s = MB_Text("Captains: ") + MB_Name(gv_captain[1]) + MB_Text(" / ") + MB_Name(gv_captain[2]) + MB_Text("<n/>") + MB_DraftLines();
    }
    else if (gv_phase == MB_PHASE_ASSIGN) {
        for (t = 1; t <= 2; t += 1) {
            s = s + MB_Text("Team " + IntToString(t) + "<n/>") + MB_AssignLines(t);
        }
    }
    else {
        for (t = 1; t <= 2; t += 1) {
            s = s + MB_Text("Team " + IntToString(t) + "<n/>");
            for (k = 1; k <= gv_teamSize[t]; k += 1) {
                s = s + MB_ObserverLine(gv_teamPlayers[t][k]);
            }
        }
    }
    DialogControlSetPropertyAsText(gv_obsInfo, c_triggerControlPropertyText, gv_observers, s);
}

// A strip name: grey while still choosing, yellow for whoever's turn it is, white otherwise.
text MB_StripName (int q, bool settled) {
    if (q == gv_turnPlayer && gv_turnPlayer != 0) {
        return TextWithColor(MB_Name(q), Color(100, 85, 0));
    }
    if (!settled) {
        return TextWithColor(MB_Name(q), Color(60, 60, 60));
    }
    return MB_Name(q);
}

int MB_AssignedUnit (int t, int q) {
    int s;
    for (s = 1; s <= gv_teamUnitCount[t]; s += 1) {
        if (gv_assignee[t][s] == q) {
            return gv_teamUnits[t][s];
        }
    }
    return 0;
}

// Pick Three: an ally's three offers under their strip slot k; once they've chosen, the rest go grey.
void MB_SetOffers (int p, int k, int q) {
    playergroup g;
    int i;
    int u;
    g = PlayerGroupSingle(p);
    for (i = 1; i <= 3; i += 1) {
        u = gv_offer[q][i];
        if (u == 0) {
            continue;
        }
        DialogControlSetPropertyAsString(gv_offerIcon[p][k][i], c_triggerControlPropertyImage, g, gv_unitIcon[u]);
        DialogControlSetPropertyAsText(gv_offerIcon[p][k][i], c_triggerControlPropertyTooltip, g, MB_Text(gv_unitLabel[u]));
        DialogControlSetPropertyAsBool(gv_offerIcon[p][k][i], c_triggerControlPropertyDesaturated, g, gv_pick[q] != 0 && gv_pick[q] != u);
        DialogControlSetVisible(gv_offerIcon[p][k][i], g, true);
    }
}

// The team strips, as each phase lets players see: their own team in Blind Random, Pick Three and
// the assignment; both teams in the drafts.
void MB_RefreshInfo () {
    int p;
    int t;
    int r;
    int k;
    int q;
    int[3] shown;
    for (p = 1; p <= 8; p += 1) {
        t = MB_TeamOf(p);
        if (t == 0) {
            continue;
        }
        MB_HideStrips(p);
        MB_SetInfo(p, MB_Text(""));
        if (gv_phase == MB_PHASE_BLIND || gv_phase == MB_PHASE_PICK_THREE) {
            for (k = 1; k <= gv_teamSize[t]; k += 1) {
                q = gv_teamPlayers[t][k];
                MB_SetStrip(p, 1, k, gv_pick[q], MB_StripName(q, gv_locked[q]));
            }
        }
        if (gv_phase == MB_PHASE_PICK_THREE) {
            for (k = 1; k <= gv_teamSize[t]; k += 1) {
                MB_SetOffers(p, k, gv_teamPlayers[t][k]);
            }
        }
        else if (gv_phase == MB_PHASE_SINGLE) {
            // Each team's row in draft order.
            shown[1] = 0;
            shown[2] = 0;
            for (k = 1; k <= gv_orderCount; k += 1) {
                q = gv_order[k];
                r = MB_TeamOf(q);
                shown[r] += 1;
                MB_SetStrip(p, r, shown[r], gv_pick[q], MB_StripName(q, gv_pick[q] != 0));
            }
        }
        else if (gv_phase == MB_PHASE_CAPTAIN_DRAFT) {
            for (r = 1; r <= 2; r += 1) {
                for (k = 1; k <= gv_teamUnitCount[r]; k += 1) {
                    MB_SetStrip(p, r, k, gv_teamUnits[r][k], MB_Text(gv_unitLabel[gv_teamUnits[r][k]]));
                }
            }
            MB_SetInfo(p, MB_Text("Captains: ") + MB_Name(gv_captain[1]) + MB_Text(" (top) and ") + MB_Name(gv_captain[2]) + MB_Text(" (bottom)"));
        }
        else if (gv_phase == MB_PHASE_ASSIGN) {
            for (k = 1; k <= gv_teamSize[t]; k += 1) {
                q = gv_teamPlayers[t][k];
                MB_SetStrip(p, 1, k, MB_AssignedUnit(t, q), MB_StripName(q, MB_AssignedUnit(t, q) != 0));
            }
        }
    }
    MB_RefreshObserver();
}

//--------------------------------------------------------------------------------------------------
// Picks panel: a small portrait per player in the top-left corner, team 1's row above team 2's, each
// on a square of the player's colour (white32 tinted, showing as a frame), as on the old map;
// hovering one shows the player's name in their colour and their unit. Shown to everyone,
// observers included; the small button at its left collapses it for whoever presses it.
//--------------------------------------------------------------------------------------------------
const int MB_PORTRAIT = 40;
const int MB_PORTRAIT_FRAME = 2;  // colour showing around the portrait
const int MB_PORTRAIT_PITCH = 48;
const int MB_PICKS_PAD = 6;       // from the screen corner
const int MB_PICKS_LEFT = 36;     // portraits start right of the toggle

void MB_CreatePicksPanel () {
    int t;
    int k;
    int p;
    int c;
    gv_picksDialog = DialogCreate(MB_PICKS_LEFT + 4 * MB_PORTRAIT_PITCH + MB_PICKS_PAD, 2 * MB_PORTRAIT_PITCH + MB_PICKS_PAD, c_anchorTopLeft, 0, 0, false);
    DialogSetImageVisible(gv_picksDialog, false);
    // The old map's toggle: a small icon under an invisible button, no text.
    c = DialogControlCreate(gv_picksDialog, c_triggerControlTypeImage);
    DialogControlSetSize(c, PlayerGroupAll(), 24, 24);
    DialogControlSetPosition(c, PlayerGroupAll(), c_anchorTopLeft, MB_PICKS_PAD, MB_PICKS_PAD + (MB_PORTRAIT + 2 * MB_PORTRAIT_FRAME - 24) / 2);
    DialogControlSetPropertyAsString(c, c_triggerControlPropertyImage, PlayerGroupAll(), "Assets\\Textures\\ui_battlenet_glue_chatpanel_minimizehover.dds");
    gv_picksToggle = DialogControlCreate(gv_picksDialog, c_triggerControlTypeButton);
    DialogControlSetSize(gv_picksToggle, PlayerGroupAll(), MB_PICKS_LEFT - 2, MB_PORTRAIT_PITCH + MB_PICKS_PAD);
    DialogControlSetPosition(gv_picksToggle, PlayerGroupAll(), c_anchorTopLeft, 0, 0);
    DialogControlFadeTransparency(gv_picksToggle, PlayerGroupAll(), 0.0, 100.0);
    for (t = 1; t <= 2; t += 1) {
        for (k = 1; k <= gv_teamSize[t]; k += 1) {
            p = gv_teamPlayers[t][k];
            if (gv_pick[p] == 0) {
                continue;
            }
            c = DialogControlCreate(gv_picksDialog, c_triggerControlTypeImage);
            DialogControlSetSize(c, PlayerGroupAll(), MB_PORTRAIT + 2 * MB_PORTRAIT_FRAME, MB_PORTRAIT + 2 * MB_PORTRAIT_FRAME);
            DialogControlSetPosition(c, PlayerGroupAll(), c_anchorTopLeft, MB_PICKS_LEFT + (k - 1) * MB_PORTRAIT_PITCH, MB_PICKS_PAD + (t - 1) * MB_PORTRAIT_PITCH);
            DialogControlSetPropertyAsString(c, c_triggerControlPropertyImage, PlayerGroupAll(), "Assets\\Textures\\white32.dds");
            DialogControlSetPropertyAsColor(c, c_triggerControlPropertyColor, PlayerGroupAll(), ColorFromIndex(PlayerGetColorIndex(p, false), c_teamColorDiffuse));
            DialogControlFadeTransparency(c, PlayerGroupAll(), 0.0, 85.0);  // a light tint: 15% colour (testing)
            gv_picksBack[t][k] = c;
            c = DialogControlCreate(gv_picksDialog, c_triggerControlTypeImage);
            DialogControlSetSize(c, PlayerGroupAll(), MB_PORTRAIT, MB_PORTRAIT);
            DialogControlSetPosition(c, PlayerGroupAll(), c_anchorTopLeft, MB_PICKS_LEFT + MB_PORTRAIT_FRAME + (k - 1) * MB_PORTRAIT_PITCH, MB_PICKS_PAD + MB_PORTRAIT_FRAME + (t - 1) * MB_PORTRAIT_PITCH);
            DialogControlSetPropertyAsString(c, c_triggerControlPropertyImage, PlayerGroupAll(), gv_unitIcon[gv_pick[p]]);
            DialogControlSetPropertyAsText(c, c_triggerControlPropertyTooltip, PlayerGroupAll(), TextWithColor(MB_Name(p), ColorFromIndex(PlayerGetColorIndex(p, false), c_teamColorDiffuse)) + MB_Text(" - " + gv_unitLabel[gv_pick[p]]));
            DialogControlSetPropertyAsBool(c, c_triggerControlPropertyAcceptMouseTarget, PlayerGroupAll(), true);
            gv_picksPortrait[t][k] = c;
        }
    }
    DialogSetVisible(gv_picksDialog, PlayerGroupAll(), true);
}

void MB_TogglePicks (int viewer) {
    int t;
    int k;
    gv_picksHidden[viewer] = !gv_picksHidden[viewer];
    for (t = 1; t <= 2; t += 1) {
        for (k = 1; k <= 4; k += 1) {
            if (gv_picksPortrait[t][k] != 0) {
                DialogControlSetVisible(gv_picksPortrait[t][k], PlayerGroupSingle(viewer), !gv_picksHidden[viewer]);
                DialogControlSetVisible(gv_picksBack[t][k], PlayerGroupSingle(viewer), !gv_picksHidden[viewer]);
            }
        }
    }
}

//--------------------------------------------------------------------------------------------------
// Clicks
//--------------------------------------------------------------------------------------------------
bool MB_OnClick (bool testConds, bool runActions) {
    int p;
    int i;
    int card;
    p = EventPlayer();
    if (p >= 1 && p <= 8 && gv_concedeDialog[p] != 0) {
        if (EventDialogControl() == gv_concedeYesButton[p]) {
            MB_ConcedeVote(p, true);
            return true;
        }
        if (EventDialogControl() == gv_concedeNoButton[p]) {
            MB_ConcedeVote(p, false);
            return true;
        }
    }
    if (gv_picksToggle != 0 && EventDialogControl() == gv_picksToggle) {
        MB_TogglePicks(p);
        return true;
    }
    if (p < 1 || p > 8) {
        return true;
    }
    i = MB_ButtonIndex(p, EventDialogControl());
    card = MB_CardIndex(p, EventDialogControl());
    if (i == 0 && card == 0) {
        return true;
    }
    if (gv_phase == MB_PHASE_VOTE && i >= 1) {
        gv_vote[p] = i;
        MB_ShowVotes();
        MB_RefreshInfo();
    }
    else if (gv_phase == MB_PHASE_BLIND && i >= 1) {
        MB_BlindClick(p, i);
    }
    else if (gv_phase == MB_PHASE_PICK_THREE) {
        MB_PickThreeClick(p, card, i);
    }
    else if (gv_phase == MB_PHASE_SINGLE || gv_phase == MB_PHASE_CAPTAIN_DRAFT) {
        MB_DraftClick(p, card, i);
        MB_RefreshInfo();
    }
    else if (gv_phase == MB_PHASE_OPT_IN && i == 2) {
        gv_optIn[p] = true;
        MB_SetButton(p, 2, "You volunteered", false);
        MB_RefreshInfo();
    }
    else if (gv_phase == MB_PHASE_ASSIGN) {
        MB_AssignClick(p, card, i);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Battle
//--------------------------------------------------------------------------------------------------
void MB_RemovePlayerUnits (int p) {
    unitgroup g;
    int i;
    g = UnitGroup(null, p, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    for (i = UnitGroupCount(g, c_unitCountAll); i >= 1; i -= 1) {
        UnitRemove(UnitGroupUnit(g, i));
    }
}

// Melee's own rules, all handled by the mod (or not used, as on the old map). Reveal would announce
// and expose every base the mod removes at load.
void MB_DisableMelee (int p) {
    MeleeSetOption(p, c_meleeOptionReveal, false);
    MeleeSetOption(p, c_meleeOptionDefeat, false);
    MeleeSetOption(p, c_meleeOptionVictory, false);
    MeleeSetOption(p, c_meleeOptionStalemate, false);
}

// The map's melee setup can run after the mod starts, and would then spawn bases and re-enable
// melee victory/defeat behind it. Wait (up to 5 s) until a player's starting units exist, give the
// setup a moment to finish, then take over.
// Melee's starting minerals arrive at load; left alone, they could be traded during the pick phase.
void MB_ZeroResources (int p) {
    PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperSetTo, 0);
    PlayerModifyPropertyInt(p, c_playerPropVespene, c_playerPropOperSetTo, 0);
}

void MB_ClearMeleeStart () {
    int p;
    fixed waited;
    bool spawned;
    waited = 0.0;
    spawned = false;
    for (p = 1; p <= 8; p += 1) {
        MB_ZeroResources(p);
    }
    while (waited < 5.0 && !spawned) {
        Wait(0.25, c_timeGame);
        waited += 0.25;
        for (p = 1; p <= 8; p += 1) {
            if (MB_TeamOf(p) != 0 && UnitGroupCount(UnitGroup(null, p, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0), c_unitCountAll) > 0) {
                spawned = true;
            }
        }
    }
    Wait(0.5, c_timeGame);
    for (p = 1; p <= 8; p += 1) {
        MB_DisableMelee(p);
        MB_RemovePlayerUnits(p);
        MB_ZeroResources(p);
    }
}

bool MB_IsCountedStructure (string type) {
    return type != "CreepTumor" && type != "CreepTumorBurrowed" && type != "CreepTumorQueen"
        && type != "AutoTurret" && type != "PointDefenseDrone" && type != "ForceField"
        && type != "OracleStasisTrap" && type != "XelNagaTower"
        && type != "TechLab" && type != "Reactor" && type != "BarracksTechLab" && type != "BarracksReactor"
        && type != "FactoryTechLab" && type != "FactoryReactor" && type != "StarportTechLab" && type != "StarportReactor";
}

bool MB_IsFloater (string type) {
    return type == "BarracksFlying" || type == "CommandCenterFlying" || type == "FactoryFlying"
        || type == "OrbitalCommandFlying" || type == "StarportFlying";
}

unitgroup MB_Structures (int p) {
    return UnitGroup(null, p, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
}

int MB_CountStructures (int p) {
    unitgroup g;
    int i;
    int n;
    g = MB_Structures(p);
    n = 0;
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        if (MB_IsCountedStructure(UnitGetType(UnitGroupUnit(g, i)))) {
            n += 1;
        }
    }
    return n;
}

// A team is out once it has no structures left or none of its players is still in the game. A
// team that started empty (a solo test) never is: type gg to end such a game.
bool MB_TeamIsOut (int t) {
    int p;
    int structures;
    bool anyone;
    if (gv_teamSize[t] == 0) {
        return false;
    }
    structures = 0;
    anyone = false;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) == t) {
            structures += MB_CountStructures(p);
            if (MB_IsPlaying(p)) {
                anyone = true;
            }
        }
    }
    return structures == 0 || !anyone;
}

void MB_EndGame (int winner) {
    int p;
    if (gv_ended) {
        return;
    }
    gv_ended = true;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) == winner) {
            MB_Marker(p, "Win");
        }
        else if (MB_TeamOf(p) != 0) {
            MB_Marker(p, "Loss");
        }
    }
    Wait(1.0, c_timeGame);
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0 && MB_IsPlaying(p)) {
            if (MB_TeamOf(p) == winner) {
                GameOver(p, c_gameOverVictory, true, true);
            }
            else {
                GameOver(p, c_gameOverDefeat, true, true);
            }
        }
    }
}

//--------------------------------------------------------------------------------------------------
// Concede vote: "gg" in chat during the battle opens a vote for the typer's team (their gg is a
// yes). Every one of the team's remaining players saying yes ends the game at once, so every
// player still in gets Victory/Defeat in their replay instead of a recording that stops when they
// leave. A failed vote locks the team out for a minute.
//--------------------------------------------------------------------------------------------------
bool MB_IsGG (string message) {
    int i;
    string w;
    for (i = 1; i <= 8; i += 1) {
        w = StringCase(StringWord(message, i), false);
        if (w == "gg" || w == "ggs" || w == "ggwp" || w == "gg!" || w == "gg." || w == "ggg") {
            return true;
        }
    }
    return false;
}

int MB_TeamPlaying (int t) {
    int p;
    int n;
    n = 0;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) == t && MB_IsPlaying(p)) {
            n += 1;
        }
    }
    return n;
}

int MB_ConcedeCount (int t, bool votedOnly, bool yes) {
    int p;
    int n;
    n = 0;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) == t && MB_IsPlaying(p) && (!votedOnly || gv_concedeVoted[p]) && gv_concedeYes[p] == yes) {
            n += 1;
        }
    }
    return n;
}

void MB_ConcedeDialog (int p) {
    if (gv_concedeDialog[p] != 0) {
        return;
    }
    gv_concedeDialog[p] = DialogCreate(380, 150, c_anchorTop, 0, 120, false);
    gv_concedeLabel[p] = DialogControlCreate(gv_concedeDialog[p], c_triggerControlTypeLabel);
    DialogControlSetSize(gv_concedeLabel[p], PlayerGroupAll(), 340, 50);
    DialogControlSetPosition(gv_concedeLabel[p], PlayerGroupAll(), c_anchorTopLeft, 20, 20);
    gv_concedeYesButton[p] = DialogControlCreate(gv_concedeDialog[p], c_triggerControlTypeButton);
    DialogControlSetSize(gv_concedeYesButton[p], PlayerGroupAll(), 160, 50);
    DialogControlSetPosition(gv_concedeYesButton[p], PlayerGroupAll(), c_anchorTopLeft, 20, 80);
    DialogControlSetPropertyAsText(gv_concedeYesButton[p], c_triggerControlPropertyText, PlayerGroupAll(), MB_Text("Concede"));
    gv_concedeNoButton[p] = DialogControlCreate(gv_concedeDialog[p], c_triggerControlTypeButton);
    DialogControlSetSize(gv_concedeNoButton[p], PlayerGroupAll(), 160, 50);
    DialogControlSetPosition(gv_concedeNoButton[p], PlayerGroupAll(), c_anchorTopLeft, 200, 80);
    DialogControlSetPropertyAsText(gv_concedeNoButton[p], c_triggerControlPropertyText, PlayerGroupAll(), MB_Text("Keep playing"));
}

void MB_ConcedeShow (int t, string s) {
    int p;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) == t && gv_concedeDialog[p] != 0) {
            DialogControlSetPropertyAsText(gv_concedeLabel[p], c_triggerControlPropertyText, PlayerGroupSingle(p), MB_Text(s));
        }
    }
}

void MB_ConcedeVote (int p, bool yes) {
    if (!gv_concedeOpen[MB_TeamOf(p)]) {
        return;
    }
    gv_concedeVoted[p] = true;
    gv_concedeYes[p] = yes;
    if (gv_concedeDialog[p] != 0) {
        DialogControlSetEnabled(gv_concedeYesButton[p], PlayerGroupSingle(p), false);
        DialogControlSetEnabled(gv_concedeNoButton[p], PlayerGroupSingle(p), false);
    }
}

void MB_RunConcedeVote (int t) {
    int needed;
    int left;
    int p;
    bool passed;
    passed = false;
    left = MB_CONCEDE_VOTE_SECONDS;
    while (left > 0 && !gv_ended) {
        // Unanimous among whoever is still in: anyone leaving mid-vote lowers the bar.
        needed = MB_TeamPlaying(t);
        if (MB_ConcedeCount(t, true, true) >= needed) {
            passed = true;
            break;
        }
        if (MB_ConcedeCount(t, true, false) > 0) {
            break;  // one no ends it
        }
        MB_ConcedeShow(t, "Concede the game? " + IntToString(MB_ConcedeCount(t, true, true)) + " of " + IntToString(needed) + " needed - " + IntToString(left) + " s");
        Wait(1.0, c_timeReal);
        left -= 1;
    }
    passed = passed || MB_ConcedeCount(t, true, true) >= MB_TeamPlaying(t);
    gv_concedeOpen[t] = false;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) == t && gv_concedeDialog[p] != 0) {
            DialogSetVisible(gv_concedeDialog[p], PlayerGroupSingle(p), false);
        }
    }
    if (gv_ended) {
        return;
    }
    if (passed) {
        MB_Say(PlayerGroupAll(), MB_Text("Team " + IntToString(t) + " conceded."));
        MB_EndGame(3 - t);
    }
    else {
        MB_Say(GameAttributePlayersForTeam(t), MB_Text("The concede vote failed. Your team can vote again in a minute."));
        gv_concedeAllowedAt[t] = GameGetMissionTime() + MB_CONCEDE_COOLDOWN_GAME_SECONDS;
    }
}

bool MB_ConcedeVoteTeam1 (bool testConds, bool runActions) {
    MB_RunConcedeVote(1);
    return true;
}

bool MB_ConcedeVoteTeam2 (bool testConds, bool runActions) {
    MB_RunConcedeVote(2);
    return true;
}

bool MB_OnChat (bool testConds, bool runActions) {
    int p;
    int t;
    int q;
    p = EventPlayer();
    t = MB_TeamOf(p);
    if (t == 0 || gv_phase != MB_PHASE_BATTLE || gv_ended || !MB_IsGG(EventChatMessage(false))) {
        return true;
    }
    if (gv_concedeOpen[t]) {
        MB_ConcedeVote(p, true);
        return true;
    }
    if (GameGetMissionTime() < gv_concedeAllowedAt[t]) {
        return true;
    }
    gv_concedeOpen[t] = true;
    for (q = 1; q <= 8; q += 1) {
        if (MB_TeamOf(q) == t && MB_IsPlaying(q)) {
            gv_concedeVoted[q] = false;
            gv_concedeYes[q] = false;
            MB_ConcedeDialog(q);
            DialogControlSetEnabled(gv_concedeYesButton[q], PlayerGroupSingle(q), true);
            DialogControlSetEnabled(gv_concedeNoButton[q], PlayerGroupSingle(q), true);
            DialogSetVisible(gv_concedeDialog[q], PlayerGroupSingle(q), true);
        }
    }
    MB_ConcedeVote(p, true);
    if (t == 1) {
        TriggerExecute(TriggerCreate("MB_ConcedeVoteTeam1"), false, false);
    }
    else {
        TriggerExecute(TriggerCreate("MB_ConcedeVoteTeam2"), false, false);
    }
    return true;
}

// A Terran left with only lifted-off buildings is warned, then those buildings burn until they
// land or die (5 life per half second, as on the old map).
void MB_CheckFloaters (int p) {
    unitgroup g;
    int i;
    int total;
    int flying;
    unit u;
    g = MB_Structures(p);
    total = 0;
    flying = 0;
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        if (MB_IsCountedStructure(UnitGetType(UnitGroupUnit(g, i)))) {
            total += 1;
            if (MB_IsFloater(UnitGetType(UnitGroupUnit(g, i)))) {
                flying += 1;
            }
        }
    }
    if (total == 0 || total != flying) {
        gv_floatSeconds[p] = 0;
        return;
    }
    if (gv_floatSeconds[p] == 0) {
        MB_Say(PlayerGroupSingle(p), MB_Text("You only have lifted-off buildings left. Land one within 10 seconds or they start burning."));
    }
    gv_floatSeconds[p] += 1;
    if (gv_floatSeconds[p] <= MB_FLOATER_WARNING_SECONDS) {
        return;
    }
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        u = UnitGroupUnit(g, i);
        if (MB_IsFloater(UnitGetType(u))) {
            UnitSetPropertyFixed(u, c_unitPropLife, UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent) - 10.0);
        }
    }
}

bool MB_WatchBattle (bool testConds, bool runActions) {
    fixed elapsed;
    int p;
    elapsed = 0.0;
    while (true) {
        Wait(1.0, c_timeGame);
        elapsed += 1.0;
        if (gv_ended) {
            return true;
        }
        if (MB_TeamIsOut(1)) {
            MB_EndGame(2);
            return true;
        }
        if (MB_TeamIsOut(2)) {
            MB_EndGame(1);
            return true;
        }
        if (elapsed >= MB_FLOATER_GRACE_GAME_SECONDS) {
            for (p = 1; p <= 8; p += 1) {
                if (MB_TeamOf(p) != 0 && PlayerRace(p) == "Terr") {
                    MB_CheckFloaters(p);
                }
            }
        }
    }
    return true;
}

void MB_CountdownSound (string id) {
    SoundPlayForPlayer(SoundLink(id, c_soundIndexAny), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
}

// Every pick, both teams, then a 3-2-1 into the battle (the engine's own countdown is hidden: it
// plays at load, before the pick phase).
void MB_RunPreview () {
    int p;
    int r;
    int k;
    int q;
    int left;
    gv_phase = MB_PHASE_PREVIEW;
    gv_turnPlayer = 0;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) == 0) {
            continue;
        }
        MB_HideButtons(p);
        MB_HideCards(p);
        MB_HideStrips(p);
        MB_Layout(p, 0, 2, false);
        for (r = 1; r <= 2; r += 1) {
            for (k = 1; k <= gv_teamSize[r]; k += 1) {
                q = gv_teamPlayers[r][k];
                MB_SetStrip(p, r, k, gv_pick[q], TextWithColor(MB_Name(q), ColorFromIndex(PlayerGetColorIndex(q, false), c_teamColorDiffuse)));
            }
        }
        MB_SetInfo(p, MB_Text(""));
    }
    MB_TitleAll(MB_Text("The picks"));
    MB_RefreshObserver();
    Wait(MB_PREVIEW_SECONDS, c_timeReal);
    for (left = 3; left >= 1; left -= 1) {
        MB_TitleAll(MB_Text("Battle starts in " + IntToString(left)));
        MB_CountdownSound("UI_Bnet_MatchCountdown" + IntToString(left));
        Wait(1.0, c_timeReal);
    }
    MB_CountdownSound("UI_Bnet_MatchCountdownGo");
}

void MB_StartBattle () {
    int p;
    int u;
    string race;
    for (p = 1; p <= 8; p += 1) {
        if (gv_dialog[p] != 0) {
            DialogDestroy(gv_dialog[p]);
        }
    }
    if (gv_obsDialog != 0) {
        DialogDestroy(gv_obsDialog);
    }
    gv_phase = MB_PHASE_BATTLE;
    for (p = 1; p <= 8; p += 1) {
        MB_DisableMelee(p);  // again, in case anything re-enabled it during the pick phase
        u = gv_pick[p];
        if (MB_TeamOf(p) == 0 || u == 0) {
            continue;
        }
        MB_Marker(p, "Pick_" + gv_unitName[u]);
        MB_Marker(p, "Start");
        if (!MB_IsPlaying(p)) {
            continue;
        }
        race = gv_unitRace[u];
        PlayerSetRace(p, race);
        MB_Unlock(p, gv_unitName[u]);
        MB_ZeroResources(p);  // whatever was traded in the pick phase anyway
        MeleeInitResourcesForPlayer(p, race);
        MeleeInitUnitsForPlayer(p, race, PlayerStartLocation(p));
        if (race == "Zerg") {
            // Melee's starting larva come with the game start, not the Hatchery; spawn them from its
            // own larva spawner so they count toward its cap of 3.
            UnitBehaviorSpawn(UnitGroupUnit(UnitGroup("Hatchery", p, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0), 1),
                "SpawnLarva", 3);
        }
    }
    MB_CreatePicksPanel();
    // Hatcheries spawn after the pick phase rather than at load, so their creep catches up fast.
    CreepSetSpeed(c_creepSpeedGrowth, 1000.0);
    UISetResourceTradeCountdownTime(MB_TRADE_LOCK_SECONDS);
    MB_Say(PlayerGroupAll(), MB_Text("MonoBattle v" + IntToString(MB_VERSION) + ". Resource trading unlocks at 10:00. Good luck!"));
    GameSetMissionTimePaused(false);
    TriggerExecute(TriggerCreate("MB_WatchBattle"), false, false);
    Wait(8.0, c_timeGame);
    CreepSetSpeed(c_creepSpeedGrowth, 100.0);
}

//--------------------------------------------------------------------------------------------------
// Main flow
//--------------------------------------------------------------------------------------------------
bool MB_Main (bool testConds, bool runActions) {
    int p;
    // The engine's 3-2-1 start countdown (GameUI.SC2Layout). Its pause can't be skipped, only hidden.
    DialogControlSetVisible(DialogControlHookupStandard(c_triggerControlTypeFlash,
        "UIContainer/FullscreenUpperContainer/GameStartCountdownPanel/FlashFrame"), PlayerGroupAll(), false);
    MB_ClearMeleeStart();
    GameSetMissionTimePaused(true);
    MB_SetupRoster();
    MB_BuildTeams();
    MB_SetTeamColors();
    for (p = 1; p <= 8; p += 1) {
        MB_DisallowEverything(p);
        if (MB_TeamOf(p) != 0) {
            TechTreeUpgradeAddLevel(p, "MB_Version", MB_VERSION);
            MB_CreatePanel(p);
        }
    }
    MB_CreateObserverPanel();
    MB_ObserverProbe();
    gv_mode = MB_LobbyMode();
    if (gv_mode == 0) {
        MB_RunVote();
    }
    else {
        MB_MarkerAll(MB_ModeMarker(gv_mode));
        MB_Say(PlayerGroupAll(), MB_Text(MB_ModeName(gv_mode) + ", set by the host."));
    }
    if (gv_mode == MB_MODE_BLIND) {
        MB_RunBlind();
    }
    else if (gv_mode == MB_MODE_SINGLE) {
        MB_RunSingle();
    }
    else if (gv_mode == MB_MODE_PICK_THREE) {
        MB_RunPickThree();
    }
    else {
        MB_RunCaptains();
    }
    MB_RunPreview();
    MB_StartBattle();
    return true;
}

void MB_Init () {
    trigger t;
    t = TriggerCreate("MB_Main");
    TriggerAddEventMapInit(t);
    t = TriggerCreate("MB_OnClick");
    TriggerAddEventDialogControl(t, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    t = TriggerCreate("MB_OnChat");
    // Not exact: any message containing gg; MB_IsGG decides. Case-sensitive, as on the old map.
    TriggerAddEventChatMessage(t, c_playerAny, "gg", false);
    TriggerAddEventChatMessage(t, c_playerAny, "GG", false);
    TriggerAddEventChatMessage(t, c_playerAny, "Gg", false);
    TriggerAddEventChatMessage(t, c_playerAny, "gG", false);
    t = TriggerCreate("MB_OnUnitCreated");
    TriggerAddEventUnitCreated(t, null, null, null);
}

void lib03F6CFD8_InitCustomScript () {
    MB_Init();
}

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
bool lib03F6CFD8_InitLib_completed = false;

void lib03F6CFD8_InitLib () {
    if (lib03F6CFD8_InitLib_completed) {
        return;
    }

    lib03F6CFD8_InitLib_completed = true;

    lib03F6CFD8_InitCustomScript();
}

