void MB_Unlock (int lp_player, string lp_name) {
    if (lp_name == "Zergling") {
        TechTreeUnitAllow(lp_player, "Zergling", true);
        TechTreeUpgradeAllow(lp_player, "zerglingattackspeed", true);
        TechTreeUpgradeAllow(lp_player, "zerglingmovementspeed", true);
    }
    else if (lp_name == "Baneling") {
        TechTreeUnitAllow(lp_player, "Baneling", true);
        TechTreeUnitAllow(lp_player, "Zergling", true);
        TechTreeUnitAllow(lp_player, "BanelingCocoon", true);
        TechTreeUpgradeAllow(lp_player, "CentrificalHooks", true);
        TechTreeUpgradeAllow(lp_player, "zerglingmovementspeed", true);
    }
    else if (lp_name == "Roach") {
        TechTreeUnitAllow(lp_player, "Roach", true);
        TechTreeUpgradeAllow(lp_player, "ZergMissileWeaponsLevel1", true);
        TechTreeUpgradeAllow(lp_player, "ZergMissileWeaponsLevel2", true);
        TechTreeUpgradeAllow(lp_player, "ZergMissileWeaponsLevel3", true);
        TechTreeUpgradeAllow(lp_player, "TunnelingClaws", true);
        TechTreeUpgradeAllow(lp_player, "GlialReconstitution", true);
    }
    else if (lp_name == "Ravager") {
        TechTreeUnitAllow(lp_player, "Ravager", true);
        TechTreeUnitAllow(lp_player, "Roach", true);
        TechTreeUnitAllow(lp_player, "RavagerCocoon", true);
        TechTreeUpgradeAllow(lp_player, "ZergMissileWeaponsLevel1", true);
        TechTreeUpgradeAllow(lp_player, "ZergMissileWeaponsLevel2", true);
        TechTreeUpgradeAllow(lp_player, "ZergMissileWeaponsLevel3", true);
        TechTreeUpgradeAllow(lp_player, "TunnelingClaws", true);
        TechTreeUpgradeAllow(lp_player, "GlialReconstitution", true);
    }
    else if (lp_name == "Hydralisk") {
        TechTreeUnitAllow(lp_player, "Hydralisk", true);
        TechTreeUpgradeAllow(lp_player, "ZergMissileWeaponsLevel1", true);
        TechTreeUpgradeAllow(lp_player, "ZergMissileWeaponsLevel2", true);
        TechTreeUpgradeAllow(lp_player, "ZergMissileWeaponsLevel3", true);
        TechTreeUpgradeAllow(lp_player, "hydraliskspeed", true);
    }
    else if (lp_name == "Lurker") {
        TechTreeUnitAllow(lp_player, "LurkerMP", true);
        TechTreeUnitAllow(lp_player, "Hydralisk", true);
        TechTreeUnitAllow(lp_player, "LurkerMPEgg", true);
        TechTreeUpgradeAllow(lp_player, "ZergMissileWeaponsLevel1", true);
        TechTreeUpgradeAllow(lp_player, "ZergMissileWeaponsLevel2", true);
        TechTreeUpgradeAllow(lp_player, "ZergMissileWeaponsLevel3", true);
        TechTreeUpgradeAllow(lp_player, "hydraliskspeed", true);
        TechTreeAbilityAllow(lp_player, AbilityCommand("UpgradeToLurkerDenMP", 0), true);
    }
    else if (lp_name == "Infestor") {
        TechTreeUnitAllow(lp_player, "Infestor", true);
        TechTreeUpgradeAllow(lp_player, "ZergMissileWeaponsLevel1", true);
        TechTreeUpgradeAllow(lp_player, "ZergMissileWeaponsLevel2", true);
        TechTreeUpgradeAllow(lp_player, "ZergMissileWeaponsLevel3", true);
        TechTreeUpgradeAllow(lp_player, "NeuralParasite", true);
        TechTreeUpgradeAllow(lp_player, "InfestorPeristalsis", true);
