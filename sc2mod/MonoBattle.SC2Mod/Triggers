                void MB_RunPickThree () {
                    int k;
                    int t;
                    int p;
                    int left;
                    gv_phase = MB_PHASE_PICK_THREE;
                    for (t = 1; t &lt;= 2; t += 1) {
                        MB_DealOffers(t);
                        for (k = 1; k &lt;= gv_teamSize[t]; k += 1) {
                            MB_PickThreeButtons(gv_teamPlayers[t][k]);
                        }
                    }
                    MB_RefreshInfo();
                    left = MB_PICK_THREE_SECONDS;
                    while (left &gt; 0 &amp;&amp; !MB_AllLocked()) {
                        MB_TitleAll(MB_Text(&quot;Pick Three - &quot; + IntToString(left) + &quot; s&quot;));
                        Wait(1.0, c_timeReal);
