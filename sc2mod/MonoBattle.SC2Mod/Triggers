                //--------------------------------------------------------------------------------------------------
                // Clicks
                //--------------------------------------------------------------------------------------------------
                bool MB_OnClick (bool testConds, bool runActions) {
                    int p;
                    int i;
                    int card;
                    p = EventPlayer();
                    if (p &gt;= 1 &amp;&amp; p &lt;= 8 &amp;&amp; gv_concedeDialog[p] != 0) {
                        if (EventDialogControl() == gv_concedeYesButton[p]) {
                            MB_ConcedeVote(p, true);
                            return true;
                        }
                        if (EventDialogControl() == gv_concedeNoButton[p]) {
                            MB_ConcedeVote(p, false);
                            return true;
                        }
                    }
                    if (gv_picksToggle != 0 &amp;&amp; EventDialogControl() == gv_picksToggle) {
                        MB_TogglePicks(p);
                        return true;
                    }
                    if (p &lt; 1 || p &gt; 8) {
                        return true;
                    }
                    i = MB_ButtonIndex(p, EventDialogControl());
                    card = MB_CardIndex(p, EventDialogControl());
                    if (i == 0 &amp;&amp; card == 0) {
                        return true;
                    }
                    if (gv_phase == MB_PHASE_VOTE &amp;&amp; i &gt;= 1) {
                        gv_vote[p] = i;
                        MB_ShowVotes();
                        MB_RefreshInfo();
                    }
                    else if (gv_phase == MB_PHASE_BLIND &amp;&amp; i &gt;= 1) {
                        MB_BlindClick(p, i);
                    }
                    else if (gv_phase == MB_PHASE_PICK_THREE) {
                        MB_PickThreeClick(p, card, i);
                    }
                    else if (gv_phase == MB_PHASE_SINGLE || gv_phase == MB_PHASE_CAPTAIN_DRAFT) {
                        MB_DraftClick(p, card, i);
                        MB_RefreshInfo();
                    }
                    else if (gv_phase == MB_PHASE_OPT_IN &amp;&amp; i == 2) {
                        gv_optIn[p] = true;
                        MB_SetButton(p, 2, &quot;You volunteered&quot;, false);
                        MB_RefreshInfo();
                    }
                    else if (gv_phase == MB_PHASE_ASSIGN) {
                        MB_AssignClick(p, card, i);
                    }
                    return true;
                }

                //--------------------------------------------------------------------------------------------------
                // Battle
                //--------------------------------------------------------------------------------------------------
                void MB_RemovePlayerUnits (int p) {
                    unitgroup g;
                    int i;
                    g = UnitGroup(null, p, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
                    for (i = UnitGroupCount(g, c_unitCountAll); i &gt;= 1; i -= 1) {
                        UnitRemove(UnitGroupUnit(g, i));
                    }
                }

                // Melee&apos;s own rules, all handled by the mod (or not used, as on the old map). Reveal would announce
                // and expose every base the mod removes at load.
                void MB_DisableMelee (int p) {
                    MeleeSetOption(p, c_meleeOptionReveal, false);
                    MeleeSetOption(p, c_meleeOptionDefeat, false);
                    MeleeSetOption(p, c_meleeOptionVictory, false);
                    MeleeSetOption(p, c_meleeOptionStalemate, false);
                }

                // The map&apos;s melee setup can run after the mod starts, and would then spawn bases and re-enable
                // melee victory/defeat behind it. Wait (up to 5 s) until a player&apos;s starting units exist, give the
                // setup a moment to finish, then take over.
                // Melee&apos;s starting minerals arrive at load; left alone, they could be traded during the pick phase.
                void MB_ZeroResources (int p) {
                    PlayerModifyPropertyInt(p, c_playerPropMinerals, c_playerPropOperSetTo, 0);
                    PlayerModifyPropertyInt(p, c_playerPropVespene, c_playerPropOperSetTo, 0);
                }

                void MB_ClearMeleeStart () {
                    int p;
                    fixed waited;
                    bool spawned;
                    waited = 0.0;
                    spawned = false;
                    for (p = 1; p &lt;= 8; p += 1) {
                        MB_ZeroResources(p);
                    }
                    while (waited &lt; 5.0 &amp;&amp; !spawned) {
                        Wait(0.25, c_timeGame);
                        waited += 0.25;
                        for (p = 1; p &lt;= 8; p += 1) {
                            if (MB_TeamOf(p) != 0 &amp;&amp; UnitGroupCount(UnitGroup(null, p, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0), c_unitCountAll) &gt; 0) {
                                spawned = true;
                            }
                        }
                    }
                    Wait(0.5, c_timeGame);
                    for (p = 1; p &lt;= 8; p += 1) {
                        MB_DisableMelee(p);
                        MB_RemovePlayerUnits(p);
                        MB_ZeroResources(p);
                    }
                }

                bool MB_IsCountedStructure (string type) {
                    return type != &quot;CreepTumor&quot; &amp;&amp; type != &quot;CreepTumorBurrowed&quot; &amp;&amp; type != &quot;CreepTumorQueen&quot;
                        &amp;&amp; type != &quot;AutoTurret&quot; &amp;&amp; type != &quot;PointDefenseDrone&quot; &amp;&amp; type != &quot;ForceField&quot;
                        &amp;&amp; type != &quot;OracleStasisTrap&quot; &amp;&amp; type != &quot;XelNagaTower&quot;
                        &amp;&amp; type != &quot;TechLab&quot; &amp;&amp; type != &quot;Reactor&quot; &amp;&amp; type != &quot;BarracksTechLab&quot; &amp;&amp; type != &quot;BarracksReactor&quot;
                        &amp;&amp; type != &quot;FactoryTechLab&quot; &amp;&amp; type != &quot;FactoryReactor&quot; &amp;&amp; type != &quot;StarportTechLab&quot; &amp;&amp; type != &quot;StarportReactor&quot;;
                }

                bool MB_IsFloater (string type) {
                    return type == &quot;BarracksFlying&quot; || type == &quot;CommandCenterFlying&quot; || type == &quot;FactoryFlying&quot;
                        || type == &quot;OrbitalCommandFlying&quot; || type == &quot;StarportFlying&quot;;
                }

                unitgroup MB_Structures (int p) {
                    return UnitGroup(null, p, RegionEntireMap(), UnitFilter((1 &lt;&lt; c_targetFilterStructure), 0, (1 &lt;&lt; c_targetFilterMissile), (1 &lt;&lt; (c_targetFilterDead - 32))), 0);
                }

                int MB_CountStructures (int p) {
                    unitgroup g;
                    int i;
                    int n;
                    g = MB_Structures(p);
                    n = 0;
                    for (i = 1; i &lt;= UnitGroupCount(g, c_unitCountAll); i += 1) {
                        if (MB_IsCountedStructure(UnitGetType(UnitGroupUnit(g, i)))) {
                            n += 1;
                        }
                    }
                    return n;
                }

                // A team is out once it has no structures left or none of its players is still in the game. A
                // team that started empty (a solo test) never is: type gg to end such a game.
                bool MB_TeamIsOut (int t) {
                    int p;
                    int structures;
                    bool anyone;
                    if (gv_teamSize[t] == 0) {
                        return false;
                    }
                    structures = 0;
                    anyone = false;
                    for (p = 1; p &lt;= 8; p += 1) {
                        if (MB_TeamOf(p) == t) {
                            structures += MB_CountStructures(p);
                            if (MB_IsPlaying(p)) {
                                anyone = true;
                            }
                        }
                    }
                    return structures == 0 || !anyone;
                }

                void MB_EndGame (int winner) {
                    int p;
                    if (gv_ended) {
                        return;
                    }
                    gv_ended = true;
                    for (p = 1; p &lt;= 8; p += 1) {
                        if (MB_TeamOf(p) == winner) {
                            MB_Marker(p, &quot;Win&quot;);
                        }
                        else if (MB_TeamOf(p) != 0) {
                            MB_Marker(p, &quot;Loss&quot;);
                        }
                    }
                    Wait(1.0, c_timeGame);
                    for (p = 1; p &lt;= 8; p += 1) {
                        if (MB_TeamOf(p) != 0 &amp;&amp; MB_IsPlaying(p)) {
                            if (MB_TeamOf(p) == winner) {
                                GameOver(p, c_gameOverVictory, true, true);
                            }
                            else {
                                GameOver(p, c_gameOverDefeat, true, true);
                            }
                        }
                    }
                }

                //--------------------------------------------------------------------------------------------------
                // Concede vote: &quot;gg&quot; in chat during the battle opens a vote for the typer&apos;s team (their gg is a
                // yes). Every one of the team&apos;s remaining players saying yes ends the game at once, so every
                // player still in gets Victory/Defeat in their replay instead of a recording that stops when they
                // leave. A failed vote locks the team out for a minute.
                //--------------------------------------------------------------------------------------------------
                bool MB_IsGG (string message) {
                    int i;
                    string w;
                    for (i = 1; i &lt;= 8; i += 1) {
                        w = StringCase(StringWord(message, i), false);
                        if (w == &quot;gg&quot; || w == &quot;ggs&quot; || w == &quot;ggwp&quot; || w == &quot;gg!&quot; || w == &quot;gg.&quot; || w == &quot;ggg&quot;) {
                            return true;
                        }
                    }
                    return false;
                }

                int MB_TeamPlaying (int t) {
                    int p;
                    int n;
                    n = 0;
                    for (p = 1; p &lt;= 8; p += 1) {
                        if (MB_TeamOf(p) == t &amp;&amp; MB_IsPlaying(p)) {
                            n += 1;
                        }
                    }
                    return n;
                }

                int MB_ConcedeCount (int t, bool votedOnly, bool yes) {
                    int p;
                    int n;
                    n = 0;
                    for (p = 1; p &lt;= 8; p += 1) {
                        if (MB_TeamOf(p) == t &amp;&amp; MB_IsPlaying(p) &amp;&amp; (!votedOnly || gv_concedeVoted[p]) &amp;&amp; gv_concedeYes[p] == yes) {
                            n += 1;
                        }
                    }
                    return n;
                }

