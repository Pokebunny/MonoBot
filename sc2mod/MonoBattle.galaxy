// A morph pick's precursor can't stand in for it: its weapon is removed.
bool MB_OnUnitCreated (bool testConds, bool runActions) {
    unit u;
    string pick;
    u = EventUnitCreatedUnit();
    if (gv_phase != MB_PHASE_BATTLE || UnitGetOwner(u) < 1 || UnitGetOwner(u) > 8) {
        return true;
    }
    if (gv_pick[UnitGetOwner(u)] == 0) {
        return true;
    }
    pick = gv_unitName[gv_pick[UnitGetOwner(u)]];
    if (pick == "Baneling" && UnitGetType(u) == "Zergling") {
        UnitWeaponRemove(u, "Claws");
    }
    else if (pick == "Ravager" && UnitGetType(u) == "Roach") {
        UnitWeaponRemove(u, "AcidSaliva");
        UnitWeaponRemove(u, "RoachMelee");
    }
    else if (pick == "Lurker" && UnitGetType(u) == "Hydralisk") {
        UnitWeaponRemove(u, "HydraliskMelee");
        UnitWeaponRemove(u, "NeedleSpines");
    }
    else if (pick == "BroodLord" && UnitGetType(u) == "Corruptor") {
        UnitWeaponRemove(u, "ParasiteSpore");
    }
    else if (pick == "Archon" && UnitGetType(u) == "DarkTemplar") {
        UnitWeaponRemove(u, "WarpBlades");
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Pick panel: a title, a 5x4 grid of buttons and an info line, one panel per player.
//--------------------------------------------------------------------------------------------------
void MB_CreatePanel (int p) {
    int i;
    int c;
    gv_dialog[p] = DialogCreate(720, 460, c_anchorCenter, 0, 0, false);
    gv_title[p] = DialogControlCreate(gv_dialog[p], c_triggerControlTypeLabel);
    DialogControlSetSize(gv_title[p], PlayerGroupAll(), 680, 40);
    DialogControlSetPosition(gv_title[p], PlayerGroupAll(), c_anchorTopLeft, 20, 24);
    for (i = 1; i <= MB_BUTTONS; i += 1) {
        c = DialogControlCreate(gv_dialog[p], c_triggerControlTypeButton);
        DialogControlSetSize(c, PlayerGroupAll(), 128, 50);
        DialogControlSetPosition(c, PlayerGroupAll(), c_anchorTopLeft, 20 + ModI(i - 1, 5) * 136, 72 + ((i - 1) / 5) * 58);
        DialogControlSetVisible(c, PlayerGroupAll(), false);
        gv_button[p][i] = c;
    }
    gv_info[p] = DialogControlCreate(gv_dialog[p], c_triggerControlTypeLabel);
    DialogControlSetSize(gv_info[p], PlayerGroupAll(), 680, 140);
    DialogControlSetPosition(gv_info[p], PlayerGroupAll(), c_anchorTopLeft, 20, 310);
    DialogSetVisible(gv_dialog[p], PlayerGroupSingle(p), true);
}

void MB_SetTitle (int p, text t) {
    DialogControlSetPropertyAsText(gv_title[p], c_triggerControlPropertyText, PlayerGroupSingle(p), t);
}

void MB_SetInfo (int p, text t) {
    DialogControlSetPropertyAsText(gv_info[p], c_triggerControlPropertyText, PlayerGroupSingle(p), t);
}

void MB_SetButtonText (int p, int i, text label, bool enabled) {
    DialogControlSetPropertyAsText(gv_button[p][i], c_triggerControlPropertyText, PlayerGroupSingle(p), label);
    DialogControlSetEnabled(gv_button[p][i], PlayerGroupSingle(p), enabled);
    DialogControlSetVisible(gv_button[p][i], PlayerGroupSingle(p), true);
}

void MB_SetButton (int p, int i, string label, bool enabled) {
    MB_SetButtonText(p, i, MB_Text(label), enabled);
}

void MB_HideButtons (int p) {
    int i;
    for (i = 1; i <= MB_BUTTONS; i += 1) {
        DialogControlSetVisible(gv_button[p][i], PlayerGroupSingle(p), false);
    }
}

void MB_TitleAll (text t) {
    int p;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0) {
            MB_SetTitle(p, t);
        }
    }
}

int MB_ButtonIndex (int p, int control) {
    int i;
    for (i = 1; i <= MB_BUTTONS; i += 1) {
        if (gv_button[p][i] == control) {
            return i;
        }
    }
    return 0;
}

text MB_Name (int p) {
    return PlayerName(p);
}

// One line per teammate: their pick so far, as each mode lets allies see it.
text MB_TeamLines (int t) {
    text s;
    string line;
    int k;
    int p;
    s = MB_Text("");
    for (k = 1; k <= gv_teamSize[t]; k += 1) {
        p = gv_teamPlayers[t][k];
        line = ": ";
        if (gv_mode == MB_MODE_PICK_THREE && gv_offer[p][1] != 0) {
            line = line + gv_unitLabel[gv_offer[p][1]] + " / " + gv_unitLabel[gv_offer[p][2]] + " / " + gv_unitLabel[gv_offer[p][3]] + " - ";
        }
        if (gv_pick[p] != 0) {
            line = line + gv_unitLabel[gv_pick[p]];
            if (gv_locked[p]) {
                line = line + " (locked)";
            }
        }
        else {
            line = line + "choosing";
        }
        s = s + MB_Name(p) + MB_Text(line + "<n/>");
    }
    return s;
}

//--------------------------------------------------------------------------------------------------
// Mode vote
//--------------------------------------------------------------------------------------------------
string MB_ModeName (int mode) {
    if (mode == MB_MODE_BLIND) {
        return "Blind Random";
    }
    if (mode == MB_MODE_SINGLE) {
        return "Single Draft";
    }
    if (mode == MB_MODE_PICK_THREE) {
        return "Pick Three";
    }
    return "Captains Draft";
}

string MB_ModeMarker (int mode) {
    if (mode == MB_MODE_BLIND) {
        return "Mode_Blind";
    }
    if (mode == MB_MODE_SINGLE) {
        return "Mode_Single";
    }
    if (mode == MB_MODE_PICK_THREE) {
        return "Mode_PickThree";
    }
    return "Mode_Captains";
}

int MB_VoteCount (int mode) {
    int p;
    int n;
    n = 0;
    for (p = 1; p <= 8; p += 1) {
        if (gv_vote[p] == mode) {
            n += 1;
        }
    }
    return n;
}

void MB_ShowVotes () {
    int p;
    int m;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0) {
            for (m = 1; m <= 4; m += 1) {
                MB_SetButton(p, m, MB_ModeName(m) + " (" + IntToString(MB_VoteCount(m)) + ")", true);
            }
        }
    }
}

bool MB_AllVoted () {
    int p;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0 && MB_IsPlaying(p) && gv_vote[p] == 0) {
            return false;
        }
    }
    return true;
}

// Most votes wins; ties (including nobody voting) are broken at random.
int MB_VoteResult () {
    int best;
    int m;
    int[5] tied;
    int n;
    best = 0;
    for (m = 1; m <= 4; m += 1) {
        if (MB_VoteCount(m) > best) {
            best = MB_VoteCount(m);
        }
    }
    n = 0;
    for (m = 1; m <= 4; m += 1) {
        if (MB_VoteCount(m) == best) {
            n += 1;
            tied[n] = m;
        }
    }
    return tied[RandomInt(1, n)];
}

void MB_RunVote () {
    int left;
    gv_phase = MB_PHASE_VOTE;
    MB_ShowVotes();
    left = MB_VOTE_SECONDS;
    while (left > 0 && !MB_AllVoted()) {
        MB_TitleAll(MB_Text("Vote for a mode - " + IntToString(left) + " s"));
        Wait(1.0, c_timeReal);
        left -= 1;
    }
    gv_mode = MB_VoteResult();
    MB_MarkerAll(MB_ModeMarker(gv_mode));
    MB_Say(PlayerGroupAll(), MB_Text(MB_ModeName(gv_mode) + " it is."));
}

//--------------------------------------------------------------------------------------------------
// Blind Random: everyone rolls at once. Choosing the Random race allows one repick, which always
// lands on a different unit. Each roll is an MB_Offer, so MonoBot sees repicks.
//--------------------------------------------------------------------------------------------------
void MB_Roll (int p, int raceChoice) {
    int u;
    u = gv_pick[p];
    while (u == gv_pick[p]) {
        if (raceChoice == 2) {
            u = MB_RandomInRace("Terr");
        }
        else if (raceChoice == 3) {
            u = MB_RandomInRace("Zerg");
        }
        else if (raceChoice == 4) {
            u = MB_RandomInRace("Prot");
        }
        else {
            u = RandomInt(1, MB_UNITS);
        }
    }
    gv_pick[p] = u;
    gv_rolls[p] += 1;
    MB_Marker(p, "Offer_" + gv_unitName[u]);
}

void MB_BlindButtons (int p) {
    MB_HideButtons(p);
    if (gv_rolls[p] == 0) {
        MB_SetButton(p, 1, "Random (one repick)", true);
        MB_SetButton(p, 2, "Terran", true);
        MB_SetButton(p, 3, "Zerg", true);
        MB_SetButton(p, 4, "Protoss", true);
    }
    else if (!gv_locked[p]) {
        MB_SetButton(p, 1, "Repick", true);
        MB_SetButton(p, 2, "Lock in " + gv_unitLabel[gv_pick[p]], true);
    }
}

void MB_BlindClick (int p, int i) {
    if (gv_locked[p]) {
        return;
    }
    if (gv_rolls[p] == 0) {
        gv_raceChoice[p] = i;
        MB_Roll(p, i);
        gv_locked[p] = (i != 1);
    }
    else if (i == 1) {
        MB_Roll(p, 1);
        gv_locked[p] = true;
    }
    else if (i == 2) {
        gv_locked[p] = true;
    }
    MB_BlindButtons(p);
    MB_RefreshInfo();
}

void MB_RunBlind () {
    int p;
    int left;
    gv_phase = MB_PHASE_BLIND;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0) {
            MB_BlindButtons(p);
        }
    }
    MB_RefreshInfo();
    left = MB_BLIND_SECONDS;
    while (left > 0) {
        MB_TitleAll(MB_Text("Blind Random - " + IntToString(left) + " s"));
        Wait(1.0, c_timeReal);
        left -= 1;
    }
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0 && gv_rolls[p] == 0) {
            MB_Roll(p, 1);
        }
        gv_locked[p] = true;
    }
}

//--------------------------------------------------------------------------------------------------
// Pick Three: each player is offered one unit per race, never the same unit twice in a team, and
// picks one. Everyone picks at once; allies see each other's offers and choices, enemies nothing.
//--------------------------------------------------------------------------------------------------
int MB_DrawForTeam (string race) {
    int u;
    u = MB_RandomInRace(race);
    while (gv_used[u]) {
        u = MB_RandomInRace(race);
    }
    gv_used[u] = true;
    return u;
}

void MB_DealOffers (int t) {
    int k;
    int p;
    int i;
    for (i = 1; i <= MB_UNITS; i += 1) {
        gv_used[i] = false;
    }
    for (k = 1; k <= gv_teamSize[t]; k += 1) {
        p = gv_teamPlayers[t][k];
        gv_offer[p][1] = MB_DrawForTeam("Zerg");
        gv_offer[p][2] = MB_DrawForTeam("Prot");
        gv_offer[p][3] = MB_DrawForTeam("Terr");
        for (i = 1; i <= 3; i += 1) {
            MB_Marker(p, "Offer_" + gv_unitName[gv_offer[p][i]]);
        }
    }
}

void MB_PickThreeButtons (int p) {
    int i;
    MB_HideButtons(p);
    for (i = 1; i <= 3; i += 1) {
        if (gv_pick[p] == gv_offer[p][i]) {
            MB_SetButton(p, i, "> " + gv_unitLabel[gv_offer[p][i]] + " <", true);
        }
        else {
            MB_SetButton(p, i, gv_unitLabel[gv_offer[p][i]], true);
        }
    }
}

void MB_PickThreeClick (int p, int i) {
    if (i < 1 || i > 3 || gv_offer[p][i] == 0) {
        return;
    }
    gv_pick[p] = gv_offer[p][i];
    MB_PickThreeButtons(p);
    MB_RefreshInfo();
}

void MB_RunPickThree () {
    int k;
    int t;
    int p;
    int left;
    gv_phase = MB_PHASE_PICK_THREE;
    for (t = 1; t <= 2; t += 1) {
        MB_DealOffers(t);
        for (k = 1; k <= gv_teamSize[t]; k += 1) {
            MB_PickThreeButtons(gv_teamPlayers[t][k]);
        }
    }
    MB_RefreshInfo();
    left = MB_PICK_THREE_SECONDS;
    while (left > 0) {
        MB_TitleAll(MB_Text("Pick Three - " + IntToString(left) + " s"));
        Wait(1.0, c_timeReal);
        left -= 1;
    }
    for (p = 1; p <= 8; p += 1) {
        if (gv_offer[p][1] != 0 && gv_pick[p] == 0) {
            gv_pick[p] = gv_offer[p][RandomInt(1, 3)];
        }
        gv_locked[p] = true;
    }
}

//--------------------------------------------------------------------------------------------------
// Drafts: a pool of 20 units drawn from all 42, shared by both teams.
//--------------------------------------------------------------------------------------------------
void MB_DealPool () {
    int[43] deck;
    int i;
    int j;
    int swap;
    for (i = 1; i <= MB_UNITS; i += 1) {
        deck[i] = i;
    }
    for (i = 1; i <= MB_POOL_SIZE; i += 1) {
        j = RandomInt(i, MB_UNITS);
        swap = deck[i];
        deck[i] = deck[j];
        deck[j] = swap;
        gv_pool[i] = deck[i];
        gv_poolTaken[i] = false;
    }
}

void MB_PoolButtons () {
    int p;
    int i;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0) {
            for (i = 1; i <= MB_POOL_SIZE; i += 1) {
                MB_SetButton(p, i, gv_unitLabel[gv_pool[i]], !gv_poolTaken[i] && p == gv_turnPlayer);
            }
        }
    }
}

int MB_RandomFreeSlot () {
    int i;
    i = RandomInt(1, MB_POOL_SIZE);
    while (gv_poolTaken[i]) {
        i = RandomInt(1, MB_POOL_SIZE);
    }
    return i;
}

// Turn order A-B-B-A-A-B-B-A by team, players shuffled within each team; the first team is random.
// `slots` turns per team (4 for Single Draft's one each; Captains Draft repeats its captain).
void MB_BuildOrder (bool captainsOnly) {
    int first;
    int[9] pattern;
    int[3] next;
    int[3][5] shuffled;
    int t;
    int k;
    int j;
    int swap;
    int n;
    first = RandomInt(1, 2);
    pattern[1] = first;
    pattern[2] = 3 - first;
    pattern[3] = 3 - first;
    pattern[4] = first;
    pattern[5] = first;
    pattern[6] = 3 - first;
    pattern[7] = 3 - first;
    pattern[8] = first;
    for (t = 1; t <= 2; t += 1) {
        next[t] = 1;
        for (k = 1; k <= gv_teamSize[t]; k += 1) {
            shuffled[t][k] = gv_teamPlayers[t][k];
        }
        for (k = 1; k <= gv_teamSize[t]; k += 1) {
            j = RandomInt(k, gv_teamSize[t]);
            swap = shuffled[t][k];
            shuffled[t][k] = shuffled[t][j];
            shuffled[t][j] = swap;
        }
    }
    gv_orderCount = 0;
    for (n = 1; n <= 8; n += 1) {
        t = pattern[n];
        if (next[t] <= gv_teamSize[t]) {
            gv_orderCount += 1;
            if (captainsOnly) {
                gv_order[gv_orderCount] = gv_captain[t];
            }
            else {
                gv_order[gv_orderCount] = shuffled[t][next[t]];
            }
            next[t] += 1;
        }
    }
}

// The current turn takes pool slot i.
void MB_TakeSlot (int i) {
    int p;
    int t;
    p = gv_turnPlayer;
    gv_poolTaken[i] = true;
    if (gv_mode == MB_MODE_SINGLE) {
        gv_pick[p] = gv_pool[i];
        gv_locked[p] = true;
    }
    else {
        t = MB_TeamOf(p);
        gv_teamUnitCount[t] += 1;
        gv_teamUnits[t][gv_teamUnitCount[t]] = gv_pool[i];
        MB_Marker(p, "Draft_" + gv_unitName[gv_pool[i]]);
    }
    gv_turnDone = true;
}

void MB_DraftClick (int p, int i) {
    if (p != gv_turnPlayer || gv_turnDone || i < 1 || i > MB_POOL_SIZE || gv_poolTaken[i]) {
        return;
    }
    MB_TakeSlot(i);
}

void MB_RunDraftTurns (string modeName) {
    int n;
    int left;
    for (n = 1; n <= gv_orderCount; n += 1) {
        gv_turnPlayer = gv_order[n];
        gv_turnDone = false;
        MB_PoolButtons();
        MB_RefreshInfo();
        left = MB_DRAFT_TURN_SECONDS;
        while (left > 0 && !gv_turnDone) {
            MB_TitleAll(MB_Text(modeName + " - ") + MB_Name(gv_turnPlayer) + MB_Text("'s turn - " + IntToString(left) + " s"));
            Wait(1.0, c_timeReal);
            left -= 1;
        }
        if (!gv_turnDone) {
            MB_TakeSlot(MB_RandomFreeSlot());
        }
    }
    gv_turnPlayer = 0;
    MB_PoolButtons();
}

void MB_RunSingle () {
    gv_phase = MB_PHASE_SINGLE;
    MB_DealPool();
    MB_BuildOrder(false);
    MB_RunDraftTurns("Single Draft");
}

//--------------------------------------------------------------------------------------------------
// Captains Draft: volunteers become captains; captains draft their team's units from the shared
// pool in snake order, then hand them out to their players.
//--------------------------------------------------------------------------------------------------
void MB_ChooseCaptains () {
    int t;
    int k;
    int n;
    int[5] volunteers;
    for (t = 1; t <= 2; t += 1) {
        n = 0;
        for (k = 1; k <= gv_teamSize[t]; k += 1) {
            if (gv_optIn[gv_teamPlayers[t][k]]) {
                n += 1;
                volunteers[n] = gv_teamPlayers[t][k];
            }
        }
        if (n > 0) {
            gv_captain[t] = volunteers[RandomInt(1, n)];
        }
        else if (gv_teamSize[t] > 0) {
            gv_captain[t] = gv_teamPlayers[t][RandomInt(1, gv_teamSize[t])];
        }
        if (gv_captain[t] != 0) {
            MB_Marker(gv_captain[t], "Captain");
        }
    }
}

void MB_AssignButtons (int t) {
    int c;
    int s;
    int k;
    text label;
    c = gv_captain[t];
    if (c == 0) {
        return;
    }
    MB_HideButtons(c);
    for (s = 1; s <= gv_teamUnitCount[t]; s += 1) {
        label = MB_Text(gv_unitLabel[gv_teamUnits[t][s]]);
        if (gv_assignee[t][s] != 0) {
            label = label + MB_Text(" -> ") + MB_Name(gv_assignee[t][s]);
        }
        if (gv_selectedSlot[t] == s) {
            label = MB_Text("> ") + label + MB_Text(" <");
        }
        MB_SetButtonText(c, s, label, true);
    }
    for (k = 1; k <= gv_teamSize[t]; k += 1) {
        MB_SetButtonText(c, 5 + k, MB_Text("Give to ") + MB_Name(gv_teamPlayers[t][k]), gv_selectedSlot[t] != 0);
    }
}

void MB_AssignClick (int p, int i) {
    int t;
    int s;
    int target;
    t = MB_TeamOf(p);
    if (t == 0 || p != gv_captain[t]) {
        return;
    }
    if (i >= 1 && i <= gv_teamUnitCount[t]) {
        gv_selectedSlot[t] = i;
    }
    else if (i >= 6 && i - 5 <= gv_teamSize[t] && gv_selectedSlot[t] != 0) {
        target = gv_teamPlayers[t][i - 5];
        for (s = 1; s <= gv_teamUnitCount[t]; s += 1) {
            if (gv_assignee[t][s] == target) {
                gv_assignee[t][s] = 0;  // a player holds one unit; reassigning frees the old one
            }
        }
        gv_assignee[t][gv_selectedSlot[t]] = target;
        gv_selectedSlot[t] = 0;
    }
    MB_AssignButtons(t);
    MB_RefreshInfo();
}

bool MB_Holds (int t, int p) {
    int s;
    for (s = 1; s <= gv_teamUnitCount[t]; s += 1) {
        if (gv_assignee[t][s] == p) {
            return true;
        }
    }
    return false;
}

// Unassigned units go to players without one, at random.
void MB_FinishAssignment (int t) {
    int s;
    int k;
    int p;
    int n;
    int[5] free;
    n = 0;
    for (k = 1; k <= gv_teamSize[t]; k += 1) {
        if (!MB_Holds(t, gv_teamPlayers[t][k])) {
            n += 1;
            free[n] = gv_teamPlayers[t][k];
        }
    }
    for (s = 1; s <= gv_teamUnitCount[t]; s += 1) {
        if (gv_assignee[t][s] == 0 && n > 0) {
            k = RandomInt(1, n);
            gv_assignee[t][s] = free[k];
            free[k] = free[n];
            n -= 1;
        }
        p = gv_assignee[t][s];
        if (p != 0) {
            gv_pick[p] = gv_teamUnits[t][s];
            gv_locked[p] = true;
        }
    }
}

void MB_RunCaptains () {
    int p;
    int t;
    int left;
    gv_phase = MB_PHASE_OPT_IN;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0) {
            MB_HideButtons(p);
            MB_SetButton(p, 1, "I'll captain", true);
        }
    }
    left = MB_OPT_IN_SECONDS;
    while (left > 0) {
        MB_TitleAll(MB_Text("Captains Draft - volunteer to captain - " + IntToString(left) + " s"));
        Wait(1.0, c_timeReal);
        left -= 1;
    }
    MB_ChooseCaptains();
    MB_Say(PlayerGroupAll(), MB_Text("Captains: ") + MB_Name(gv_captain[1]) + MB_Text(" and ") + MB_Name(gv_captain[2]));

    gv_phase = MB_PHASE_CAPTAIN_DRAFT;
    MB_DealPool();
    MB_BuildOrder(true);
    MB_RunDraftTurns("Captains Draft");

    gv_phase = MB_PHASE_ASSIGN;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0) {
            MB_HideButtons(p);
        }
    }
    for (t = 1; t <= 2; t += 1) {
        MB_AssignButtons(t);
    }
    MB_RefreshInfo();
    left = MB_ASSIGN_SECONDS;
    while (left > 0) {
        MB_TitleAll(MB_Text("Captains assign units - " + IntToString(left) + " s"));
        Wait(1.0, c_timeReal);
        left -= 1;
    }
    for (t = 1; t <= 2; t += 1) {
        MB_FinishAssignment(t);
    }
}

//--------------------------------------------------------------------------------------------------
// Info line: what each player may see right now.
//--------------------------------------------------------------------------------------------------
text MB_DraftLines () {
    text s;
    string line;
    int t;
    int k;
    s = MB_Text("");
    for (t = 1; t <= 2; t += 1) {
        line = "Team " + IntToString(t) + ": ";
        for (k = 1; k <= gv_teamUnitCount[t]; k += 1) {
            line = line + gv_unitLabel[gv_teamUnits[t][k]] + "  ";
        }
        s = s + MB_Text(line + "<n/>");
    }
    return s;
}

text MB_AssignLines (int t) {
    text s;
    int k;
    s = MB_Text("");
    for (k = 1; k <= gv_teamUnitCount[t]; k += 1) {
        s = s + MB_Text(gv_unitLabel[gv_teamUnits[t][k]]);
        if (gv_assignee[t][k] != 0) {
            s = s + MB_Text(" -> ") + MB_Name(gv_assignee[t][k]);
        }
        s = s + MB_Text("<n/>");
    }
    return s;
}

text MB_SingleLines () {
    text s;
    int n;
    int p;
    s = MB_Text("");
    for (n = 1; n <= gv_orderCount; n += 1) {
        p = gv_order[n];
        s = s + MB_Name(p) + MB_Text(" (team " + IntToString(MB_TeamOf(p)) + "): ");
        if (gv_pick[p] != 0) {
            s = s + MB_Text(gv_unitLabel[gv_pick[p]]);
        }
        s = s + MB_Text("<n/>");
    }
    return s;
}

void MB_RefreshInfo () {
    int p;
    int t;
    for (p = 1; p <= 8; p += 1) {
        t = MB_TeamOf(p);
        if (t == 0) {
            continue;
        }
        if (gv_phase == MB_PHASE_BLIND || gv_phase == MB_PHASE_PICK_THREE) {
            MB_SetInfo(p, MB_Text("Your team:<n/>") + MB_TeamLines(t));
        }
        else if (gv_phase == MB_PHASE_SINGLE) {
            MB_SetInfo(p, MB_SingleLines());
        }
        else if (gv_phase == MB_PHASE_CAPTAIN_DRAFT) {
            MB_SetInfo(p, MB_DraftLines());
        }
        else if (gv_phase == MB_PHASE_ASSIGN) {
            MB_SetInfo(p, MB_Text("Your team's units:<n/>") + MB_AssignLines(t));
        }
    }
}

//--------------------------------------------------------------------------------------------------
// Picks panel: a portrait per player in the top-left corner, team 1 above team 2, the player's name
// beneath in their colour and "unit - player" on hover. Shown to everyone, observers included; the
// Picks button collapses it for whoever presses it.
//--------------------------------------------------------------------------------------------------
void MB_CreatePicksPanel () {
    int t;
    int k;
    int p;
    int c;
    gv_picksDialog = DialogCreate(300, 180, c_anchorTopLeft, 0, 45, false);
    DialogSetImageVisible(gv_picksDialog, false);
    gv_picksToggle = DialogControlCreate(gv_picksDialog, c_triggerControlTypeButton);
    DialogControlSetSize(gv_picksToggle, PlayerGroupAll(), 64, 30);
    DialogControlSetPosition(gv_picksToggle, PlayerGroupAll(), c_anchorTopLeft, 0, 0);
    DialogControlSetPropertyAsText(gv_picksToggle, c_triggerControlPropertyText, PlayerGroupAll(), MB_Text("Picks"));
    for (t = 1; t <= 2; t += 1) {
        for (k = 1; k <= gv_teamSize[t]; k += 1) {
            p = gv_teamPlayers[t][k];
            if (gv_pick[p] == 0) {
                continue;
            }
            c = DialogControlCreate(gv_picksDialog, c_triggerControlTypeImage);
            DialogControlSetSize(c, PlayerGroupAll(), 48, 48);
            DialogControlSetPosition(c, PlayerGroupAll(), c_anchorTopLeft, 70 + (k - 1) * 58, 4 + (t - 1) * 74);
            DialogControlSetPropertyAsString(c, c_triggerControlPropertyImage, PlayerGroupAll(), gv_unitIcon[gv_pick[p]]);
            DialogControlSetPropertyAsText(c, c_triggerControlPropertyTooltip, PlayerGroupAll(), MB_Text(gv_unitLabel[gv_pick[p]] + " - ") + MB_Name(p));
            DialogControlSetPropertyAsBool(c, c_triggerControlPropertyAcceptMouseTarget, PlayerGroupAll(), true);
            gv_picksPortrait[t][k] = c;
            c = DialogControlCreate(gv_picksDialog, c_triggerControlTypeLabel);
            DialogControlSetSize(c, PlayerGroupAll(), 56, 20);
            DialogControlSetPosition(c, PlayerGroupAll(), c_anchorTopLeft, 66 + (k - 1) * 58, 52 + (t - 1) * 74);
            DialogControlSetPropertyAsText(c, c_triggerControlPropertyText, PlayerGroupAll(), TextWithColor(MB_Name(p), ColorFromIndex(PlayerGetColorIndex(p, false), c_teamColorDiffuse)));
            gv_picksName[t][k] = c;
        }
    }
    DialogSetVisible(gv_picksDialog, PlayerGroupAll(), true);
}

void MB_TogglePicks (int viewer) {
    int t;
    int k;
    gv_picksHidden[viewer] = !gv_picksHidden[viewer];
    for (t = 1; t <= 2; t += 1) {
        for (k = 1; k <= 4; k += 1) {
            if (gv_picksPortrait[t][k] != 0) {
                DialogControlSetVisible(gv_picksPortrait[t][k], PlayerGroupSingle(viewer), !gv_picksHidden[viewer]);
                DialogControlSetVisible(gv_picksName[t][k], PlayerGroupSingle(viewer), !gv_picksHidden[viewer]);
            }
        }
    }
}

//--------------------------------------------------------------------------------------------------
// Clicks
//--------------------------------------------------------------------------------------------------
bool MB_OnClick (bool testConds, bool runActions) {
    int p;
    int i;
    p = EventPlayer();
    if (gv_picksToggle != 0 && EventDialogControl() == gv_picksToggle) {
        MB_TogglePicks(p);
        return true;
    }
    if (p < 1 || p > 8) {
        return true;
    }
    i = MB_ButtonIndex(p, EventDialogControl());
    if (i == 0) {
        return true;
    }
    if (gv_phase == MB_PHASE_VOTE && i <= 4) {
        gv_vote[p] = i;
        MB_ShowVotes();
    }
    else if (gv_phase == MB_PHASE_BLIND) {
        MB_BlindClick(p, i);
    }
    else if (gv_phase == MB_PHASE_PICK_THREE) {
        MB_PickThreeClick(p, i);
    }
    else if (gv_phase == MB_PHASE_SINGLE || gv_phase == MB_PHASE_CAPTAIN_DRAFT) {
        MB_DraftClick(p, i);
        MB_RefreshInfo();
    }
    else if (gv_phase == MB_PHASE_OPT_IN && i == 1) {
        gv_optIn[p] = true;
        MB_SetButton(p, 1, "You volunteered", false);
    }
    else if (gv_phase == MB_PHASE_ASSIGN) {
        MB_AssignClick(p, i);
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
// Battle
//--------------------------------------------------------------------------------------------------
void MB_RemovePlayerUnits (int p) {
    unitgroup g;
    int i;
    g = UnitGroup(null, p, RegionEntireMap(), UnitFilter(0, 0, 0, 0), 0);
    for (i = UnitGroupCount(g, c_unitCountAll); i >= 1; i -= 1) {
        UnitRemove(UnitGroupUnit(g, i));
    }
}

void MB_SetTrading (bool allowed) {
    int p;
    int q;
    for (p = 1; p <= 8; p += 1) {
        for (q = 1; q <= 8; q += 1) {
            if (p != q && MB_TeamOf(p) != 0 && MB_TeamOf(p) == MB_TeamOf(q)) {
                PlayerSetAlliance(p, c_allianceIdTrade, q, allowed);
            }
        }
    }
}

bool MB_TradeUnlock (bool testConds, bool runActions) {
    Wait(MB_TRADE_LOCK_GAME_SECONDS, c_timeGame);
    MB_SetTrading(true);
    MB_Say(PlayerGroupAll(), MB_Text("Resource trading is now allowed."));
    return true;
}

bool MB_IsCountedStructure (string type) {
    return type != "CreepTumor" && type != "CreepTumorBurrowed" && type != "CreepTumorQueen"
        && type != "AutoTurret" && type != "PointDefenseDrone" && type != "ForceField"
        && type != "OracleStasisTrap" && type != "XelNagaTower"
        && type != "TechLab" && type != "Reactor" && type != "BarracksTechLab" && type != "BarracksReactor"
        && type != "FactoryTechLab" && type != "FactoryReactor" && type != "StarportTechLab" && type != "StarportReactor";
}

bool MB_IsFloater (string type) {
    return type == "BarracksFlying" || type == "CommandCenterFlying" || type == "FactoryFlying"
        || type == "OrbitalCommandFlying" || type == "StarportFlying";
}

unitgroup MB_Structures (int p) {
    return UnitGroup(null, p, RegionEntireMap(), UnitFilter((1 << c_targetFilterStructure), 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32))), 0);
}

int MB_CountStructures (int p) {
    unitgroup g;
    int i;
    int n;
    g = MB_Structures(p);
    n = 0;
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        if (MB_IsCountedStructure(UnitGetType(UnitGroupUnit(g, i)))) {
            n += 1;
        }
    }
    return n;
}

// A team is out once it has no structures left or none of its players is still in the game.
bool MB_TeamIsOut (int t) {
    int p;
    int structures;
    bool anyone;
    structures = 0;
    anyone = false;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) == t) {
            structures += MB_CountStructures(p);
            if (MB_IsPlaying(p)) {
                anyone = true;
            }
        }
    }
    return structures == 0 || !anyone;
}

void MB_EndGame (int winner) {
    int p;
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) == winner) {
            MB_Marker(p, "Win");
        }
        else if (MB_TeamOf(p) != 0) {
            MB_Marker(p, "Loss");
        }
    }
    Wait(1.0, c_timeGame);
    for (p = 1; p <= 8; p += 1) {
        if (MB_TeamOf(p) != 0 && MB_IsPlaying(p)) {
            if (MB_TeamOf(p) == winner) {
                GameOver(p, c_gameOverVictory, true, true);
            }
            else {
                GameOver(p, c_gameOverDefeat, true, true);
            }
        }
    }
}

// A Terran left with only lifted-off buildings is warned, then those buildings burn until they
// land or die (5 life per half second, as on the old map).
void MB_CheckFloaters (int p) {
    unitgroup g;
    int i;
    int total;
    int flying;
    unit u;
    g = MB_Structures(p);
    total = 0;
    flying = 0;
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        if (MB_IsCountedStructure(UnitGetType(UnitGroupUnit(g, i)))) {
            total += 1;
            if (MB_IsFloater(UnitGetType(UnitGroupUnit(g, i)))) {
                flying += 1;
            }
        }
    }
    if (total == 0 || total != flying) {
        gv_floatSeconds[p] = 0;
        return;
    }
    if (gv_floatSeconds[p] == 0) {
        MB_Say(PlayerGroupSingle(p), MB_Text("You only have lifted-off buildings left. Land one within 10 seconds or they start burning."));
    }
    gv_floatSeconds[p] += 1;
    if (gv_floatSeconds[p] <= MB_FLOATER_WARNING_SECONDS) {
        return;
    }
    for (i = 1; i <= UnitGroupCount(g, c_unitCountAll); i += 1) {
        u = UnitGroupUnit(g, i);
        if (MB_IsFloater(UnitGetType(u))) {
            UnitSetPropertyFixed(u, c_unitPropLife, UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent) - 10.0);
        }
    }
}

bool MB_WatchBattle (bool testConds, bool runActions) {
    fixed elapsed;
    int p;
    elapsed = 0.0;
    while (true) {
        Wait(1.0, c_timeGame);
        elapsed += 1.0;
        if (MB_TeamIsOut(1)) {
            MB_EndGame(2);
            return true;
        }
        if (MB_TeamIsOut(2)) {
            MB_EndGame(1);
            return true;
        }
        if (elapsed >= MB_FLOATER_GRACE_GAME_SECONDS) {
            for (p = 1; p <= 8; p += 1) {
                if (MB_TeamOf(p) != 0 && PlayerRace(p) == "Terr") {
                    MB_CheckFloaters(p);
                }
            }
        }
    }
    return true;
}

void MB_StartBattle () {
    int p;
    int u;
    string race;
    for (p = 1; p <= 8; p += 1) {
        if (gv_dialog[p] != 0) {
            DialogDestroy(gv_dialog[p]);
        }
    }
    gv_phase = MB_PHASE_BATTLE;
    for (p = 1; p <= 8; p += 1) {
        u = gv_pick[p];
        if (MB_TeamOf(p) == 0 || u == 0) {
            continue;
        }
        MB_Marker(p, "Pick_" + gv_unitName[u]);
        MB_Marker(p, "Start");
        if (!MB_IsPlaying(p)) {
            continue;
        }
        race = gv_unitRace[u];
        PlayerSetRace(p, race);
        MB_Unlock(p, gv_unitName[u]);
        MeleeInitResourcesForPlayer(p, race);
        MeleeInitUnitsForPlayer(p, race, PlayerStartLocation(p));
    }
    MB_CreatePicksPanel();
    // Hatcheries spawn after the pick phase rather than at load, so their creep catches up fast.
    CreepSetSpeed(c_creepSpeedGrowth, 1000.0);
    MB_SetTrading(false);
    MB_Say(PlayerGroupAll(), MB_Text("Resource trading unlocks at 10:00. Good luck!"));
    GameSetMissionTimePaused(false);
    TriggerExecute(TriggerCreate("MB_TradeUnlock"), false, false);
    TriggerExecute(TriggerCreate("MB_WatchBattle"), false, false);
    Wait(8.0, c_timeGame);
    CreepSetSpeed(c_creepSpeedGrowth, 100.0);
}

//--------------------------------------------------------------------------------------------------
// Main flow
//--------------------------------------------------------------------------------------------------
bool MB_Main (bool testConds, bool runActions) {
    int p;
    // Let the map's own melee setup run first, then take it over.
    Wait(0.5, c_timeGame);
    GameSetMissionTimePaused(true);
    MB_SetupRoster();
    MB_BuildTeams();
    for (p = 1; p <= 8; p += 1) {
        MeleeSetOption(p, c_meleeOptionDefeat, false);
        MeleeSetOption(p, c_meleeOptionVictory, false);
        MeleeSetOption(p, c_meleeOptionStalemate, false);
        MB_RemovePlayerUnits(p);
        MB_DisallowEverything(p);
        if (MB_TeamOf(p) != 0) {
            TechTreeUpgradeAddLevel(p, "MB_Version", MB_VERSION);
            MB_CreatePanel(p);
        }
    }
    MB_RunVote();
    if (gv_mode == MB_MODE_BLIND) {
        MB_RunBlind();
    }
    else if (gv_mode == MB_MODE_SINGLE) {
        MB_RunSingle();
    }
    else if (gv_mode == MB_MODE_PICK_THREE) {
        MB_RunPickThree();
    }
    else {
        MB_RunCaptains();
    }
    MB_StartBattle();
    return true;
}

void MB_Init () {
    trigger t;
    t = TriggerCreate("MB_Main");
    TriggerAddEventMapInit(t);
    t = TriggerCreate("MB_OnClick");
    TriggerAddEventDialogControl(t, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
    t = TriggerCreate("MB_OnUnitCreated");
    TriggerAddEventUnitCreated(t, null, null, null);
}
