                void MB_ConcedeVote (int p, bool yes) {
                    if (!gv_concedeOpen[MB_TeamOf(p)]) {
                        return;
                    }
                    gv_concedeVoted[p] = true;
                    gv_concedeYes[p] = yes;
                    if (gv_concedeDialog[p] != 0) {
                        DialogControlSetEnabled(gv_concedeYesButton[p], PlayerGroupSingle(p), false);
                        DialogControlSetEnabled(gv_concedeNoButton[p], PlayerGroupSingle(p), false);
                    }
                }

                void MB_RunConcedeVote (int t) {
                    int needed;
                    int left;
                    int p;
                    bool passed;
                    passed = false;
                    left = MB_CONCEDE_VOTE_SECONDS;
                    while (left &gt; 0 &amp;&amp; !gv_ended) {
                        // Unanimous among whoever is still in: anyone leaving mid-vote lowers the bar.
                        needed = MB_TeamPlaying(t);
                        if (MB_ConcedeCount(t, true, true) &gt;= needed) {
                            passed = true;
                            break;
                        }
                        if (MB_ConcedeCount(t, true, false) &gt; 0) {
                            break;  // one no ends it
                        }
                        MB_ConcedeShow(t, &quot;Concede the game? &quot; + IntToString(MB_ConcedeCount(t, true, true)) + &quot; of &quot; + IntToString(needed) + &quot; needed - &quot; + IntToString(left) + &quot; s&quot;);
                        Wait(1.0, c_timeReal);
                        left -= 1;
                    }
                    passed = passed || MB_ConcedeCount(t, true, true) &gt;= MB_TeamPlaying(t);
                    gv_concedeOpen[t] = false;
                    for (p = 1; p &lt;= 8; p += 1) {
                        if (MB_TeamOf(p) == t &amp;&amp; gv_concedeDialog[p] != 0) {
                            DialogSetVisible(gv_concedeDialog[p], PlayerGroupSingle(p), false);
                        }
                    }
                    if (gv_ended) {
                        return;
                    }
                    if (passed) {
                        MB_Say(PlayerGroupAll(), MB_Text(&quot;Team &quot; + IntToString(t) + &quot; conceded.&quot;));
                        MB_EndGame(3 - t);
                    }
                    else {
                        MB_Say(GameAttributePlayersForTeam(t), MB_Text(&quot;The concede vote failed. Your team can vote again in a minute.&quot;));
                        gv_concedeAllowedAt[t] = GameGetMissionTime() + MB_CONCEDE_COOLDOWN_GAME_SECONDS;
                    }
                }

                bool MB_ConcedeVoteTeam1 (bool testConds, bool runActions) {
                    MB_RunConcedeVote(1);
                    return true;
                }

                bool MB_ConcedeVoteTeam2 (bool testConds, bool runActions) {
                    MB_RunConcedeVote(2);
                    return true;
                }

                bool MB_OnChat (bool testConds, bool runActions) {
                    int p;
                    int t;
                    int q;
                    p = EventPlayer();
                    t = MB_TeamOf(p);
                    if (t == 0 || gv_phase != MB_PHASE_BATTLE || gv_ended || !MB_IsGG(EventChatMessage(false))) {
                        return true;
                    }
                    if (gv_concedeOpen[t]) {
                        MB_ConcedeVote(p, true);
                        return true;
                    }
                    if (GameGetMissionTime() &lt; gv_concedeAllowedAt[t]) {
                        return true;
                    }
                    gv_concedeOpen[t] = true;
                    for (q = 1; q &lt;= 8; q += 1) {
                        if (MB_TeamOf(q) == t &amp;&amp; MB_IsPlaying(q)) {
                            gv_concedeVoted[q] = false;
                            gv_concedeYes[q] = false;
                            MB_ConcedeDialog(q);
                            DialogControlSetEnabled(gv_concedeYesButton[q], PlayerGroupSingle(q), true);
                            DialogControlSetEnabled(gv_concedeNoButton[q], PlayerGroupSingle(q), true);
                            DialogSetVisible(gv_concedeDialog[q], PlayerGroupSingle(q), true);
                        }
                    }
                    MB_ConcedeVote(p, true);
                    if (t == 1) {
                        TriggerExecute(TriggerCreate(&quot;MB_ConcedeVoteTeam1&quot;), false, false);
                    }
                    else {
                        TriggerExecute(TriggerCreate(&quot;MB_ConcedeVoteTeam2&quot;), false, false);
                    }
                    return true;
                }

                // A Terran left with only lifted-off buildings is warned, then those buildings burn until they
                // land or die (5 life per half second, as on the old map).
                void MB_CheckFloaters (int p) {
                    unitgroup g;
                    int i;
                    int total;
                    int flying;
                    unit u;
                    g = MB_Structures(p);
                    total = 0;
                    flying = 0;
                    for (i = 1; i &lt;= UnitGroupCount(g, c_unitCountAll); i += 1) {
                        if (MB_IsCountedStructure(UnitGetType(UnitGroupUnit(g, i)))) {
                            total += 1;
                            if (MB_IsFloater(UnitGetType(UnitGroupUnit(g, i)))) {
                                flying += 1;
                            }
                        }
                    }
                    if (total == 0 || total != flying) {
                        gv_floatSeconds[p] = 0;
                        return;
                    }
                    if (gv_floatSeconds[p] == 0) {
                        MB_Say(PlayerGroupSingle(p), MB_Text(&quot;You only have lifted-off buildings left. Land one within 10 seconds or they start burning.&quot;));
                    }
                    gv_floatSeconds[p] += 1;
                    if (gv_floatSeconds[p] &lt;= MB_FLOATER_WARNING_SECONDS) {
                        return;
                    }
                    for (i = 1; i &lt;= UnitGroupCount(g, c_unitCountAll); i += 1) {
                        u = UnitGroupUnit(g, i);
                        if (MB_IsFloater(UnitGetType(u))) {
                            UnitSetPropertyFixed(u, c_unitPropLife, UnitGetPropertyFixed(u, c_unitPropLife, c_unitPropCurrent) - 10.0);
                        }
                    }
                }

                bool MB_WatchBattle (bool testConds, bool runActions) {
                    fixed elapsed;
                    int p;
                    elapsed = 0.0;
                    while (true) {
                        Wait(1.0, c_timeGame);
                        elapsed += 1.0;
                        if (gv_ended) {
                            return true;
                        }
                        if (MB_TeamIsOut(1)) {
                            MB_EndGame(2);
                            return true;
                        }
                        if (MB_TeamIsOut(2)) {
                            MB_EndGame(1);
                            return true;
                        }
                        if (elapsed &gt;= MB_FLOATER_GRACE_GAME_SECONDS) {
                            for (p = 1; p &lt;= 8; p += 1) {
                                if (MB_TeamOf(p) != 0 &amp;&amp; PlayerRace(p) == &quot;Terr&quot;) {
                                    MB_CheckFloaters(p);
                                }
                            }
                        }
                    }
                    return true;
                }

                void MB_CountdownSound (string id) {
                    SoundPlayForPlayer(SoundLink(id, c_soundIndexAny), c_maxPlayers, PlayerGroupAll(), 100.0, 0.0);
                }

                // Every pick, both teams, then a 3-2-1 into the battle (the engine&apos;s own countdown is hidden: it
                // plays at load, before the pick phase).
                void MB_RunPreview () {
                    int p;
                    int r;
                    int k;
                    int q;
                    int left;
                    gv_phase = MB_PHASE_PREVIEW;
                    gv_turnPlayer = 0;
                    for (p = 1; p &lt;= 8; p += 1) {
                        if (MB_TeamOf(p) == 0) {
                            continue;
                        }
                        MB_HideButtons(p);
                        MB_HideCards(p);
                        MB_HideStrips(p);
                        MB_Layout(p, 0, 2, false);
                        for (r = 1; r &lt;= 2; r += 1) {
                            for (k = 1; k &lt;= gv_teamSize[r]; k += 1) {
                                q = gv_teamPlayers[r][k];
                                MB_SetStrip(p, r, k, gv_pick[q], TextWithColor(MB_Name(q), ColorFromIndex(PlayerGetColorIndex(q, false), c_teamColorDiffuse)));
                            }
                        }
                        MB_SetInfo(p, MB_Text(&quot;&quot;));
                    }
                    MB_TitleAll(MB_Text(&quot;The picks&quot;));
                    MB_RefreshObserver();
                    Wait(MB_PREVIEW_SECONDS, c_timeReal);
                    for (left = 3; left &gt;= 1; left -= 1) {
                        MB_TitleAll(MB_Text(&quot;Battle starts in &quot; + IntToString(left)));
                        MB_CountdownSound(&quot;UI_Bnet_MatchCountdown&quot; + IntToString(left));
                        Wait(1.0, c_timeReal);
                    }
                    MB_CountdownSound(&quot;UI_Bnet_MatchCountdownGo&quot;);
                }

                void MB_StartBattle () {
                    int p;
                    int u;
                    string race;
                    for (p = 1; p &lt;= 8; p += 1) {
                        if (gv_dialog[p] != 0) {
                            DialogDestroy(gv_dialog[p]);
                        }
                    }
                    if (gv_obsDialog != 0) {
                        DialogDestroy(gv_obsDialog);
                    }
                    gv_phase = MB_PHASE_BATTLE;
                    for (p = 1; p &lt;= 8; p += 1) {
                        MB_DisableMelee(p);  // again, in case anything re-enabled it during the pick phase
                        u = gv_pick[p];
                        if (MB_TeamOf(p) == 0 || u == 0) {
                            continue;
                        }
                        MB_Marker(p, &quot;Pick_&quot; + gv_unitName[u]);
                        MB_Marker(p, &quot;Start&quot;);
                        if (!MB_IsPlaying(p)) {
                            continue;
                        }
                        race = gv_unitRace[u];
                        PlayerSetRace(p, race);
                        MB_Unlock(p, gv_unitName[u]);
                        MB_ZeroResources(p);  // whatever was traded in the pick phase anyway
                        MeleeInitResourcesForPlayer(p, race);
                        MeleeInitUnitsForPlayer(p, race, PlayerStartLocation(p));
                    }
                    MB_CreatePicksPanel();
                    // Hatcheries spawn after the pick phase rather than at load, so their creep catches up fast.
                    CreepSetSpeed(c_creepSpeedGrowth, 1000.0);
                    UISetResourceTradeCountdownTime(MB_TRADE_LOCK_SECONDS);
                    MB_Say(PlayerGroupAll(), MB_Text(&quot;Resource trading unlocks at 10:00. Good luck!&quot;));
                    GameSetMissionTimePaused(false);
                    TriggerExecute(TriggerCreate(&quot;MB_WatchBattle&quot;), false, false);
                    Wait(8.0, c_timeGame);
                    CreepSetSpeed(c_creepSpeedGrowth, 100.0);
                }

                //--------------------------------------------------------------------------------------------------
                // Main flow
                //--------------------------------------------------------------------------------------------------
                bool MB_Main (bool testConds, bool runActions) {
                    int p;
                    // The engine&apos;s 3-2-1 start countdown (GameUI.SC2Layout). Its pause can&apos;t be skipped, only hidden.
                    DialogControlSetVisible(DialogControlHookupStandard(c_triggerControlTypeFlash,
                        &quot;UIContainer/FullscreenUpperContainer/GameStartCountdownPanel/FlashFrame&quot;), PlayerGroupAll(), false);
                    MB_ClearMeleeStart();
                    GameSetMissionTimePaused(true);
                    MB_SetupRoster();
                    MB_BuildTeams();
                    for (p = 1; p &lt;= 8; p += 1) {
                        MB_DisallowEverything(p);
                        if (MB_TeamOf(p) != 0) {
                            TechTreeUpgradeAddLevel(p, &quot;MB_Version&quot;, MB_VERSION);
                            MB_CreatePanel(p);
                        }
                    }
                    MB_CreateObserverPanel();
                    gv_mode = MB_LobbyMode();
                    if (gv_mode == 0) {
                        MB_RunVote();
                    }
                    else {
                        MB_MarkerAll(MB_ModeMarker(gv_mode));
                        MB_Say(PlayerGroupAll(), MB_Text(MB_ModeName(gv_mode) + &quot;, set by the host.&quot;));
                    }
                    if (gv_mode == MB_MODE_BLIND) {
                        MB_RunBlind();
                    }
                    else if (gv_mode == MB_MODE_SINGLE) {
                        MB_RunSingle();
                    }
                    else if (gv_mode == MB_MODE_PICK_THREE) {
                        MB_RunPickThree();
                    }
                    else {
                        MB_RunCaptains();
                    }
                    MB_RunPreview();
                    MB_StartBattle();
                    return true;
                }

                void MB_Init () {
                    trigger t;
                    t = TriggerCreate(&quot;MB_Main&quot;);
                    TriggerAddEventMapInit(t);
                    t = TriggerCreate(&quot;MB_OnClick&quot;);
                    TriggerAddEventDialogControl(t, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
                    t = TriggerCreate(&quot;MB_OnChat&quot;);
                    // Not exact: any message containing gg; MB_IsGG decides. Case-sensitive, as on the old map.
                    TriggerAddEventChatMessage(t, c_playerAny, &quot;gg&quot;, false);
                    TriggerAddEventChatMessage(t, c_playerAny, &quot;GG&quot;, false);
                    TriggerAddEventChatMessage(t, c_playerAny, &quot;Gg&quot;, false);
                    TriggerAddEventChatMessage(t, c_playerAny, &quot;gG&quot;, false);
                    t = TriggerCreate(&quot;MB_OnUnitCreated&quot;);
                    TriggerAddEventUnitCreated(t, null, null, null);
                }
            </ScriptCode>
            <InitFunc>MB_Init</InitFunc>
        </Element>
    </Library>
