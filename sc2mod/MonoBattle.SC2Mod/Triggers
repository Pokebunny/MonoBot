                // One player&apos;s state in the vote, Blind Random, Pick Three or the captain opt-in.
                text MB_ObserverLine (int p) {
                    string s;
                    s = &quot;: &quot;;
                    if (gv_phase == MB_PHASE_VOTE) {
                        if (gv_vote[p] != 0) {
                            s = s + &quot;votes &quot; + MB_ModeName(gv_vote[p]);
                        }
                        else {
                            s = s + &quot;-&quot;;
                        }
                    }
                    else if (gv_phase == MB_PHASE_BLIND) {
                        if (gv_rolls[p] == 0) {
                            s = s + &quot;choosing a race&quot;;
                        }
                        else if (gv_rolls[p] &gt; 1) {
                            s = s + gv_unitLabel[gv_firstRoll[p]] + &quot; -&gt; &quot; + gv_unitLabel[gv_pick[p]] + &quot; (repick)&quot;;
                        }
                        else {
                            s = s + gv_unitLabel[gv_pick[p]];
                            if (!gv_locked[p]) {
                                s = s + &quot; (may repick)&quot;;
                            }
                        }
                    }
                    else if (gv_phase == MB_PHASE_PICK_THREE &amp;&amp; gv_offer[p][1] != 0) {
                        s = s + gv_unitLabel[gv_offer[p][1]] + &quot; / &quot; + gv_unitLabel[gv_offer[p][2]] + &quot; / &quot; + gv_unitLabel[gv_offer[p][3]];
                        if (gv_pick[p] != 0) {
                            s = s + &quot; -&gt; &quot; + gv_unitLabel[gv_pick[p]];
                            if (gv_locked[p]) {
                                s = s + &quot; (locked)&quot;;
                            }
                        }
                    }
                    else if (gv_phase == MB_PHASE_PREVIEW) {
                        s = s + gv_unitLabel[gv_pick[p]];
                    }
                    else if (gv_phase == MB_PHASE_OPT_IN) {
                        if (gv_optIn[p]) {
                            s = s + &quot;volunteered&quot;;
                        }
                        else {
                            s = s + &quot;-&quot;;
                        }
                    }
                    return MB_Name(p) + MB_Text(s + &quot;&lt;n/&gt;&quot;);
                }

                void MB_RefreshObserver () {
                    text s;
                    int t;
                    int k;
                    if (gv_obsDialog == 0) {
                        return;
                    }
                    s = MB_Text(&quot;&quot;);
                    if (gv_phase == MB_PHASE_SINGLE) {
