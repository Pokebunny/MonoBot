                //--------------------------------------------------------------------------------------------------
                // Drafts: a pool of 20 units drawn from all 42, shared by both teams.
                //--------------------------------------------------------------------------------------------------
                void MB_DealPool () {
                    int[43] deck;
                    int i;
                    int j;
                    int swap;
                    for (i = 1; i &lt;= MB_UNITS; i += 1) {
                        deck[i] = i;
                    }
                    for (i = 1; i &lt;= MB_POOL_SIZE; i += 1) {
                        j = RandomInt(i, MB_UNITS);
                        swap = deck[i];
                        deck[i] = deck[j];
                        deck[j] = swap;
                        gv_pool[i] = deck[i];
                        gv_poolTaken[i] = false;
                    }
                }

                // The pool as 20 cards: taken units grey; whoever&apos;s turn it is selects one (green) and confirms it
                // with the button beneath, everyone else waits.
                void MB_PoolButtons () {
                    int p;
                    int i;
                    for (p = 1; p &lt;= 8; p += 1) {
                        if (MB_TeamOf(p) != 0) {
                            MB_Layout(p, MB_POOL_SIZE, 2, true);
                            MB_HideButtons(p);
                            for (i = 1; i &lt;= MB_POOL_SIZE; i += 1) {
                                if (gv_poolTaken[i]) {
                                    MB_SetCard(p, i, gv_pool[i], MB_CARD_TAKEN);
                                }
                                else if (p != gv_turnPlayer) {
                                    MB_SetCard(p, i, gv_pool[i], MB_CARD_SHOWN);
                                }
                                else if (i == gv_draftSelected) {
                                    MB_SetCard(p, i, gv_pool[i], MB_CARD_CHOSEN);
                                }
                                else {
                                    MB_SetCard(p, i, gv_pool[i], MB_CARD_PICKABLE);
                                }
                            }
                            if (gv_turnPlayer == 0) {
                                continue;
                            }
                            if (p == gv_turnPlayer) {
                                MB_SetButton(p, 2, &quot;Confirm pick&quot;, gv_draftSelected != 0);
                            }
                            else {
                                MB_SetButtonText(p, 2, MB_Text(&quot;Waiting for &quot;) + MB_Name(gv_turnPlayer), false);
                            }
                        }
                    }
                }

                int MB_RandomFreeSlot () {
                    int i;
                    i = RandomInt(1, MB_POOL_SIZE);
                    while (gv_poolTaken[i]) {
                        i = RandomInt(1, MB_POOL_SIZE);
                    }
                    return i;
                }

                // Turn order A-B-B-A-A-B-B-A by team, players shuffled within each team; the first team is random.
                // One turn per player; in Captains Draft every one of a team&apos;s turns is its captain&apos;s.
                void MB_BuildOrder (bool captainsOnly) {
                    int first;
                    int[9] pattern;
                    int[3] next;
                    int[3][5] shuffled;
                    int t;
                    int k;
                    int j;
                    int swap;
                    int n;
                    first = RandomInt(1, 2);
                    pattern[1] = first;
                    pattern[2] = 3 - first;
                    pattern[3] = 3 - first;
                    pattern[4] = first;
                    pattern[5] = first;
                    pattern[6] = 3 - first;
                    pattern[7] = 3 - first;
                    pattern[8] = first;
                    for (t = 1; t &lt;= 2; t += 1) {
                        next[t] = 1;
                        for (k = 1; k &lt;= gv_teamSize[t]; k += 1) {
                            shuffled[t][k] = gv_teamPlayers[t][k];
                        }
                        for (k = 1; k &lt;= gv_teamSize[t]; k += 1) {
                            j = RandomInt(k, gv_teamSize[t]);
                            swap = shuffled[t][k];
                            shuffled[t][k] = shuffled[t][j];
                            shuffled[t][j] = swap;
                        }
                    }
                    gv_orderCount = 0;
                    for (n = 1; n &lt;= 8; n += 1) {
                        t = pattern[n];
                        if (next[t] &lt;= gv_teamSize[t]) {
                            gv_orderCount += 1;
                            if (captainsOnly) {
                                gv_order[gv_orderCount] = gv_captain[t];
                            }
                            else {
                                gv_order[gv_orderCount] = shuffled[t][next[t]];
                            }
                            next[t] += 1;
                        }
                    }
                }

                // The current turn takes pool slot i.
                void MB_TakeSlot (int i) {
                    int p;
                    int t;
                    p = gv_turnPlayer;
                    gv_poolTaken[i] = true;
                    if (gv_mode == MB_MODE_SINGLE) {
                        gv_pick[p] = gv_pool[i];
                        gv_locked[p] = true;
                    }
                    else {
                        t = MB_TeamOf(p);
                        gv_teamUnitCount[t] += 1;
                        gv_teamUnits[t][gv_teamUnitCount[t]] = gv_pool[i];
                        MB_Marker(p, &quot;Draft_&quot; + gv_unitName[gv_pool[i]]);
                    }
                    gv_turnDone = true;
                }

                // A card selects (and can be changed); the Confirm button takes it.
                void MB_DraftClick (int p, int card, int button) {
                    if (p != gv_turnPlayer || gv_turnDone) {
                        return;
                    }
                    if (card &gt;= 1 &amp;&amp; card &lt;= MB_POOL_SIZE &amp;&amp; !gv_poolTaken[card]) {
                        gv_draftSelected = card;
                    }
                    else if (button == 2 &amp;&amp; gv_draftSelected != 0) {
                        MB_TakeSlot(gv_draftSelected);
                    }
                    else {
                        return;
                    }
                    MB_PoolButtons();
                }

                void MB_RunDraftTurns (string modeName) {
                    int n;
                    int left;
                    for (n = 1; n &lt;= gv_orderCount; n += 1) {
                        gv_turnPlayer = gv_order[n];
                        gv_turnDone = false;
                        gv_draftSelected = 0;
                        MB_PoolButtons();
                        MB_RefreshInfo();
                        left = MB_DRAFT_TURN_SECONDS;
                        while (left &gt; 0 &amp;&amp; !gv_turnDone) {
                            MB_TitleAll(MB_Text(modeName + &quot; - &quot;) + MB_Name(gv_turnPlayer) + MB_Text(&quot;&apos;s turn - &quot; + IntToString(left) + &quot; s&quot;));
                            Wait(1.0, c_timeReal);
                            left -= 1;
                        }
                        if (!gv_turnDone &amp;&amp; gv_draftSelected != 0) {
                            MB_TakeSlot(gv_draftSelected);  // timed out: the selected unit, as on the old map
                        }
                        else if (!gv_turnDone) {
                            MB_TakeSlot(MB_RandomFreeSlot());
                        }
                    }
                    gv_turnPlayer = 0;
                    MB_PoolButtons();
                }

                void MB_RunSingle () {
                    gv_phase = MB_PHASE_SINGLE;
                    MB_DealPool();
                    MB_BuildOrder(false);
                    MB_RunDraftTurns(&quot;Single Draft&quot;);
                }

                //--------------------------------------------------------------------------------------------------
                // Captains Draft: volunteers become captains; captains draft their team&apos;s units from the shared
                // pool in snake order, then hand them out to their players.
                //--------------------------------------------------------------------------------------------------
                // A random volunteer still in the game, else a random player still in, else anyone on the team
                // (a captain who has left would leave the whole team&apos;s draft to chance).
                void MB_ChooseCaptains () {
                    int t;
                    int k;
                    int p;
                    int n;
                    int m;
                    int[5] volunteers;
                    int[5] present;
                    for (t = 1; t &lt;= 2; t += 1) {
                        n = 0;
                        m = 0;
                        for (k = 1; k &lt;= gv_teamSize[t]; k += 1) {
                            p = gv_teamPlayers[t][k];
                            if (MB_IsPlaying(p)) {
                                m += 1;
                                present[m] = p;
                                if (gv_optIn[p]) {
                                    n += 1;
                                    volunteers[n] = p;
                                }
                            }
                        }
                        if (n &gt; 0) {
                            gv_captain[t] = volunteers[RandomInt(1, n)];
                        }
                        else if (m &gt; 0) {
                            gv_captain[t] = present[RandomInt(1, m)];
                        }
                        else if (gv_teamSize[t] &gt; 0) {
                            gv_captain[t] = gv_teamPlayers[t][RandomInt(1, gv_teamSize[t])];
                        }
                        if (gv_captain[t] != 0) {
                            MB_Marker(gv_captain[t], &quot;Captain&quot;);
                        }
                    }
                }

                // The team&apos;s drafted units as cards for the whole team; the captain can pick one (green), then a
                // &quot;To &lt;player&gt;&quot; text button to hand it over. Who holds what shows in the team strip.
                void MB_AssignButtons (int t) {
                    int c;
                    int s;
                    int k;
                    int q;
                    c = gv_captain[t];
                    for (k = 1; k &lt;= gv_teamSize[t]; k += 1) {
                        q = gv_teamPlayers[t][k];
                        MB_Layout(q, gv_teamUnitCount[t], 1, false);
                        MB_HideButtons(q);
                        MB_HideCards(q);
                        for (s = 1; s &lt;= gv_teamUnitCount[t]; s += 1) {
                            if (q != c) {
                                MB_SetCard(q, s, gv_teamUnits[t][s], MB_CARD_SHOWN);
                            }
                            else if (gv_selectedSlot[t] == s) {
                                MB_SetCard(q, s, gv_teamUnits[t][s], MB_CARD_CHOSEN);
                            }
                            else {
                                MB_SetCard(q, s, gv_teamUnits[t][s], MB_CARD_PICKABLE);
                            }
                        }
                    }
                    if (c == 0) {
                        return;
                    }
                    for (k = 1; k &lt;= gv_teamSize[t]; k += 1) {
                        MB_SetButtonText(c, k, MB_Text(&quot;To &quot;) + MB_Name(gv_teamPlayers[t][k]), gv_selectedSlot[t] != 0);
                    }
                }

                void MB_AssignClick (int p, int card, int button) {
                    int t;
                    int s;
                    int target;
                    t = MB_TeamOf(p);
                    if (t == 0 || p != gv_captain[t]) {
                        return;
                    }
                    if (card &gt;= 1 &amp;&amp; card &lt;= gv_teamUnitCount[t]) {
                        gv_selectedSlot[t] = card;
                    }
                    else if (button &gt;= 1 &amp;&amp; button &lt;= gv_teamSize[t] &amp;&amp; gv_selectedSlot[t] != 0) {
                        target = gv_teamPlayers[t][button];
                        for (s = 1; s &lt;= gv_teamUnitCount[t]; s += 1) {
                            if (gv_assignee[t][s] == target) {
                                gv_assignee[t][s] = 0;  // a player holds one unit; reassigning frees the old one
                            }
                        }
                        gv_assignee[t][gv_selectedSlot[t]] = target;
                        gv_selectedSlot[t] = 0;
                    }
                    else {
                        return;
                    }
                    MB_AssignButtons(t);
                    MB_RefreshInfo();
                }

                bool MB_Holds (int t, int p) {
                    int s;
                    for (s = 1; s &lt;= gv_teamUnitCount[t]; s += 1) {
                        if (gv_assignee[t][s] == p) {
                            return true;
                        }
                    }
                    return false;
                }

                // Unassigned units go to players without one, at random.
                void MB_FinishAssignment (int t) {
                    int s;
                    int k;
                    int p;
                    int n;
                    int[5] free;
                    n = 0;
                    for (k = 1; k &lt;= gv_teamSize[t]; k += 1) {
                        if (!MB_Holds(t, gv_teamPlayers[t][k])) {
                            n += 1;
                            free[n] = gv_teamPlayers[t][k];
                        }
                    }
                    for (s = 1; s &lt;= gv_teamUnitCount[t]; s += 1) {
                        if (gv_assignee[t][s] == 0 &amp;&amp; n &gt; 0) {
                            k = RandomInt(1, n);
                            gv_assignee[t][s] = free[k];
                            free[k] = free[n];
                            n -= 1;
                        }
                        p = gv_assignee[t][s];
                        if (p != 0) {
                            gv_pick[p] = gv_teamUnits[t][s];
                            gv_locked[p] = true;
                        }
                    }
                }

                void MB_RunCaptains () {
                    int p;
                    int t;
                    int left;
                    gv_phase = MB_PHASE_OPT_IN;
                    for (p = 1; p &lt;= 8; p += 1) {
                        if (MB_TeamOf(p) != 0) {
                            MB_Layout(p, 0, 0, false);
                            MB_HideButtons(p);
                            MB_HideCards(p);
                            MB_SetButton(p, 2, &quot;I&apos;ll captain&quot;, true);
                        }
                    }
                    MB_RefreshInfo();
                    left = MB_OPT_IN_SECONDS;
                    while (left &gt; 0) {
                        MB_TitleAll(MB_Text(&quot;Captains Draft - volunteer to captain - &quot; + IntToString(left) + &quot; s&quot;));
                        Wait(1.0, c_timeReal);
                        left -= 1;
                    }
                    MB_ChooseCaptains();
                    MB_Say(PlayerGroupAll(), MB_Text(&quot;Captains: &quot;) + MB_Name(gv_captain[1]) + MB_Text(&quot; and &quot;) + MB_Name(gv_captain[2]));

                    gv_phase = MB_PHASE_CAPTAIN_DRAFT;
                    MB_DealPool();
                    MB_BuildOrder(true);
                    MB_RunDraftTurns(&quot;Captains Draft&quot;);

                    gv_phase = MB_PHASE_ASSIGN;
                    for (p = 1; p &lt;= 8; p += 1) {
                        if (MB_TeamOf(p) != 0) {
                            MB_HideButtons(p);
                        }
                    }
                    for (t = 1; t &lt;= 2; t += 1) {
                        MB_AssignButtons(t);
                    }
                    MB_RefreshInfo();
                    left = MB_ASSIGN_SECONDS;
                    while (left &gt; 0) {
                        MB_TitleAll(MB_Text(&quot;Captains assign units - &quot; + IntToString(left) + &quot; s&quot;));
                        Wait(1.0, c_timeReal);
                        left -= 1;
                    }
                    for (t = 1; t &lt;= 2; t += 1) {
                        MB_FinishAssignment(t);
                    }
                }

