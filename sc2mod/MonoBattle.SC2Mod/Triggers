                // A strip name: grey while still choosing, yellow for whoever&apos;s turn it is, white otherwise.
                text MB_StripName (int q, bool settled) {
                    if (q == gv_turnPlayer &amp;&amp; gv_turnPlayer != 0) {
                        return TextWithColor(MB_Name(q), Color(100, 85, 0));
                    }
                    if (!settled) {
                        return TextWithColor(MB_Name(q), Color(60, 60, 60));
                    }
                    return MB_Name(q);
                }

                int MB_AssignedUnit (int t, int q) {
                    int s;
                    for (s = 1; s &lt;= gv_teamUnitCount[t]; s += 1) {
                        if (gv_assignee[t][s] == q) {
                            return gv_teamUnits[t][s];
                        }
                    }
                    return 0;
                }

                // The team strips, as each phase lets players see: their own team in Blind Random, Pick Three and
                // the assignment; both teams in the drafts.
                void MB_RefreshInfo () {
                    int p;
                    int t;
                    int r;
                    int k;
                    int q;
                    int[3] shown;
                    for (p = 1; p &lt;= 8; p += 1) {
                        t = MB_TeamOf(p);
                        if (t == 0) {
                            continue;
                        }
                        MB_HideStrips(p);
                        MB_SetInfo(p, MB_Text(&quot;&quot;));
                        if (gv_phase == MB_PHASE_BLIND || gv_phase == MB_PHASE_PICK_THREE) {
                            for (k = 1; k &lt;= gv_teamSize[t]; k += 1) {
                                q = gv_teamPlayers[t][k];
                                MB_SetStrip(p, 1, k, gv_pick[q], MB_StripName(q, gv_locked[q]));
                            }
                        }
                        else if (gv_phase == MB_PHASE_SINGLE) {
                            // Each team&apos;s row in draft order.
                            shown[1] = 0;
                            shown[2] = 0;
                            for (k = 1; k &lt;= gv_orderCount; k += 1) {
                                q = gv_order[k];
                                r = MB_TeamOf(q);
                                shown[r] += 1;
                                MB_SetStrip(p, r, shown[r], gv_pick[q], MB_StripName(q, gv_pick[q] != 0));
                            }
                        }
                        else if (gv_phase == MB_PHASE_CAPTAIN_DRAFT) {
                            for (r = 1; r &lt;= 2; r += 1) {
                                for (k = 1; k &lt;= gv_teamUnitCount[r]; k += 1) {
                                    MB_SetStrip(p, r, k, gv_teamUnits[r][k], MB_Text(gv_unitLabel[gv_teamUnits[r][k]]));
                                }
                            }
                            MB_SetInfo(p, MB_Text(&quot;Captains: &quot;) + MB_Name(gv_captain[1]) + MB_Text(&quot; (top) and &quot;) + MB_Name(gv_captain[2]) + MB_Text(&quot; (bottom)&quot;));
                        }
                        else if (gv_phase == MB_PHASE_ASSIGN) {
                            for (k = 1; k &lt;= gv_teamSize[t]; k += 1) {
                                q = gv_teamPlayers[t][k];
                                MB_SetStrip(p, 1, k, MB_AssignedUnit(t, q), MB_StripName(q, MB_AssignedUnit(t, q) != 0));
                            }
                        }
                    }
                    MB_RefreshObserver();
                }

